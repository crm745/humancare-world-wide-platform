// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // E.164 (e.g. "+919876543210") so the same number can't be stored two ways.
  mobile       String?  @unique
  countryCode  String   @default("+91") @map("country_code")
  // Null for accounts created before passwords were introduced (OTP-only) and for
  // Google/Apple accounts — the login flow makes the former set one on next login.
  passwordHash String?  @map("password_hash")
  // False only between password registration and its OTP check; social and older
  // accounts were already verified when they were created.
  isVerified   Boolean  @default(true) @map("is_verified")
  // Set once the person proves they own the email (OTP at sign-up or on change, or the
  // provider vouching for it on Google/Apple sign-in). Google/Apple only ever link to
  // an existing account whose email is verified.
  emailVerifiedAt DateTime? @map("email_verified_at")
  failedLoginCount Int  @default(0) @map("failed_login_count")
  lockedUntil  DateTime? @map("locked_until")
  // Baked into every token; bumping it (password reset) kills existing sessions.
  tokenVersion Int      @default(0) @map("token_version")
  googleId     String?  @unique @map("google_id")
  appleId      String?  @unique @map("apple_id")
  pushToken    String?  @map("push_token")
  createdAt    DateTime @default(now()) @map("created_at")
  requests     ServiceRequest[]
  consents     UserConsent[]

  @@map("users")
}

// What the patient agreed to at sign-up, kept as proof (who, what, which wording, when,
// from where). One row per consent; the optional marketing one is stored either way so
// a "no" is on record too.
model UserConsent {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  // A half-finished sign-up that gets replaced takes its consent rows with it.
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "terms_privacy" | "medical_disclaimer" | "marketing"
  accepted   Boolean
  // Which wording was shown (CONSENT_VERSION in auth.controller.js); bump it whenever
  // the consent text in the app changes.
  version    String
  ipAddress  String?  @map("ip_address")
  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@index([userId])
  @@map("user_consents")
}

// Audit trail of account security events: sign-ups, logins, failures, lockouts, password
// and contact changes. Never holds a password or OTP; typed identifiers are stored
// masked. No foreign key on purpose: the history outlives a deleted account.
model SecurityEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  event      String   // see EVENTS in modules/auth/security-events.js
  identifier String?  // masked mobile/email that was typed, e.g. "+91 •••••3210"
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @db.VarChar(255) @map("user_agent")
  detail     Json?
  // Who performed the action, when it isn't a patient (userId is patient-only): an Admin
  // reviewing a corporate registration, the registrant themselves, or the system. Null on
  // patient rows, so existing history is untouched.
  actorType  String?  @db.VarChar(16) @map("actor_type") // "admin" | "registrant" | "system"
  actorId    Int?     @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("security_events")
}

model OtpCode {
  id         Int       @id @default(autoincrement())
  identifier String    // mobile number or email, depending on purpose
  codeHash   String    @map("code_hash")
  purpose    String    // "patient_register" | "patient_register_email" | "patient_login" | "patient_password_reset" | "patient_change_mobile" | "patient_change_email" | "corporate_login" | "corporate_password_reset"
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("otp_codes")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // Null while the account is only invited and has not chosen a password yet. Login code
  // must treat null as "cannot sign in with a password", never pass it to bcrypt.
  passwordHash String?  @map("password_hash")
  // "admin" handles day-to-day ops (cases, patients, corporates, tickets); "superadmin"
  // additionally manages other admin accounts and sensitive settings (the services
  // catalog today, billing later) — see requireSuperAdmin in auth.middleware.js.
  role         String   @default("admin")
  // Lets a regular admin review corporate registrations (list, approve, reject, provision).
  // Superadmins can always do so. Granted by a server-side script, never by the request.
  corporateReview Boolean @default(false) @map("corporate_review")
  // "invited" | "pending_passkey" | "active" | "disabled". Accounts that existed before the
  // Admin Lock System are "active". Admins are soft-disabled, never deleted.
  status       String   @default("active") @db.VarChar(24)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  // Failed password AND passkey attempts share this counter; it is reset only after both
  // factors have succeeded.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt       DateTime? @map("last_login_at")
  disabledAt        DateTime? @map("disabled_at")
  disabledReason    String?   @db.VarChar(255) @map("disabled_reason")
  // The Admin who disabled this account. A plain id with no foreign key, like the other
  // "by" columns; the history must survive whatever happens to the referenced row.
  disabledBy        Int?      @map("disabled_by")
  createdAt    DateTime @default(now()) @map("created_at")
  // Existing rows get the time of the migration; it is maintained by Prisma from then on.
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  invitations       AdminInvitation[]
  sessions          AdminSession[]
  passkeys          AdminPasskey[]
  challenges        AdminWebAuthnChallenge[]
  recoveryTargets   AdminRecoveryRequest[]  @relation("RecoveryTarget")
  recoveryRequested AdminRecoveryRequest[]  @relation("RecoveryRequester")
  recoveryApprovals AdminRecoveryApproval[] @relation("RecoveryApprover")

  @@index([status])
  @@map("admin_users")
}

// A request to regain access after losing every passkey. Normal recovery needs approval
// from two different active Admins with the "superadmin" role; neither the target nor the
// requester may approve (enforced in code, in one transaction). Kept permanently as security
// history, so nothing that references it can be deleted.
model AdminRecoveryRequest {
  id                 Int       @id @default(autoincrement())
  // The Admin who lost the passkey.
  adminId            Int       @map("admin_id")
  admin              AdminUser @relation("RecoveryTarget", fields: [adminId], references: [id], onDelete: Restrict)
  // The authenticated Admin who filed it. Null when it was not filed by a signed-in Admin
  // (a self-service request from the target's mailbox, or a server operator).
  requestedByAdminId Int?      @map("requested_by_admin_id")
  requestedBy        AdminUser? @relation("RecoveryRequester", fields: [requestedByAdminId], references: [id], onDelete: Restrict)
  requestedVia       String    @db.VarChar(16) @map("requested_via")
  requestIp          String?   @map("request_ip")
  reason             String?   @db.VarChar(500)
  status             String    @default("pending") @db.VarChar(24) // "pending" | "approved" | "completed" | "rejected" | "expired" | "cancelled"
  approvalsRequired  Int       @default(2) @map("approvals_required")
  approvedAt         DateTime? @map("approved_at")
  expiresAt          DateTime  @map("expires_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  approvals          AdminRecoveryApproval[]
  invitations        AdminInvitation[]
  challenges         AdminWebAuthnChallenge[]

  @@index([adminId, status])
  @@index([status, expiresAt])
  @@index([requestedByAdminId])
  @@map("admin_recovery_requests")
}

// The emailed, single-use link that activates an account or enrols / recovers a passkey.
// Only a SHA-256 hash of the token is stored, never the token. Kept permanently.
model AdminInvitation {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  purpose           String    @db.VarChar(24) // "activation" | "passkey_enrollment" | "passkey_recovery"
  // Set for a normal passkey recovery. Null for the other purposes, and for break-glass
  // recovery issued through the separately authorised emergency path.
  recoveryRequestId Int?      @map("recovery_request_id")
  recoveryRequest   AdminRecoveryRequest? @relation(fields: [recoveryRequestId], references: [id], onDelete: Restrict)
  tokenHash         String    @unique @db.Char(64) @map("token_hash")
  // The address the link was sent to, as it was at the time.
  sentToEmail       String    @map("sent_to_email")
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  challenges        AdminWebAuthnChallenge[]

  @@index([adminId, createdAt])
  @@index([expiresAt])
  @@index([recoveryRequestId])
  @@map("admin_invitations")
}

// A signed-in dashboard session, checked against this row on every request. At most two are
// active per Admin (enforced in code under a row lock on admin_users). It locks after 30
// minutes idle and ends at the absolute limit; both times are fixed when it is created or
// last used. History is kept 365 days after expiry/revocation.
model AdminSession {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  // When the session locks for inactivity (lastActivityAt + 30 minutes), not when it ends.
  idleExpiresAt     DateTime  @map("idle_expires_at")
  // When the session ends regardless of activity (createdAt + 7 days).
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  lockedAt          DateTime? @map("locked_at")
  // Failed passkey unlock attempts on this session, tracked apart from the account counter.
  unlockFailedCount Int       @default(0) @map("unlock_failed_count")
  unlockLockedUntil DateTime? @map("unlock_locked_until")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @db.VarChar(64) @map("revoked_reason")
  // The Admin who revoked it; null when the system or a server operator did.
  revokedBy         Int?      @map("revoked_by")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @db.VarChar(255) @map("user_agent")
  refreshTokens     AdminRefreshToken[]
  challenges        AdminWebAuthnChallenge[]

  @@index([adminId, revokedAt, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("admin_sessions")
}

// One refresh token of a session. Each use rotates it: the used token is marked and points at
// its replacement, and presenting a used token again revokes the whole session. Only the
// SHA-256 hash is stored. Rows are kept (not deleted) when a session is revoked; they are
// purged with their session, children first.
model AdminRefreshToken {
  id           Int          @id @default(autoincrement())
  sessionId    Int          @map("session_id")
  session      AdminSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash    String       @unique @db.Char(64) @map("token_hash")
  expiresAt    DateTime     @map("expires_at")
  usedAt       DateTime?    @map("used_at")
  // The token that replaced this one when it was used. SET NULL (not Restrict) so the
  // retention purge can remove old tokens without deleting them in chain order.
  replacedById Int?         @unique @map("replaced_by_id")
  replacedBy   AdminRefreshToken? @relation("RefreshChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AdminRefreshToken? @relation("RefreshChain")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

// A registered WebAuthn credential. Only the public key is stored. The credential id is
// case-sensitive but this database's collation is not, so lookups use credentialIdHash (a
// SHA-256 hex digest) and the raw id is kept as bytes.
model AdminPasskey {
  id               Int       @id @default(autoincrement())
  adminId          Int       @map("admin_id")
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  credentialIdHash String    @unique @db.Char(64) @map("credential_id_hash")
  credentialId     Bytes     @map("credential_id")
  publicKey        Bytes     @map("public_key")
  signCount        Int       @default(0) @db.UnsignedInt @map("sign_count")
  transports       Json?
  aaguid           String?   @db.VarChar(36)
  deviceType       String?   @db.VarChar(16) @map("device_type")
  backedUp         Boolean?  @map("backed_up")
  label            String?   @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @db.VarChar(64) @map("revoked_reason")
  // The Admin who revoked it; null when a server operator did.
  revokedBy        Int?      @map("revoked_by")

  @@index([adminId, revokedAt])
  @@map("admin_passkeys")
}

// One Admin's decision on a recovery request. UNIQUE (request, approver) so nobody decides
// twice; that the approver is an active "superadmin" and is neither the target nor the
// requester is checked in code, in the same transaction that completes the recovery.
model AdminRecoveryApproval {
  id           Int       @id @default(autoincrement())
  requestId    Int       @map("request_id")
  request      AdminRecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approverId   Int       @map("approver_id")
  approver     AdminUser @relation("RecoveryApprover", fields: [approverId], references: [id], onDelete: Restrict)
  // The approver's role at the moment of the decision.
  approverRole String    @db.VarChar(16) @map("approver_role")
  decision     String    @db.VarChar(16) // "approved" | "rejected"
  reason       String?   @db.VarChar(500)
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([requestId, approverId])
  @@index([approverId])
  @@map("admin_recovery_approvals")
}

// A single-use WebAuthn challenge, bound to what it was issued for: an invitation
// (registration), a recovery request (recovery_registration), or a session (unlock; a
// registration from a signed-in session also binds here). Short-lived (2 minutes) and
// cleaned up after it expires, so unlike the durable tables it cascades from the Admin.
model AdminWebAuthnChallenge {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  purpose           String    @db.VarChar(32) // "registration" | "authentication" | "unlock" | "recovery_registration"
  challenge         String    @db.VarChar(191)
  invitationId      Int?      @map("invitation_id")
  invitation        AdminInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  recoveryRequestId Int?      @map("recovery_request_id")
  recoveryRequest   AdminRecoveryRequest? @relation(fields: [recoveryRequestId], references: [id], onDelete: SetNull)
  sessionId         Int?      @map("session_id")
  session           AdminSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([adminId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([invitationId])
  @@index([recoveryRequestId])
  @@index([sessionId])
  @@map("admin_webauthn_challenges")
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  subtitle    String?
  description String?  @db.Text
  provides    Json?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// A pending corporate-partner application — the corporate-portal's /register wizard
// (company → bank → documents → mobile verified by Firebase → email verify → HumanCare
// approval → Admin provisions the initial Owner).
// company/bank are stored as submitted (not yet a real Corporate row); once an authorised
// Admin approves it and then provisions the Owner, a real Corporate + CorporateUser are
// created and linked back here via corporateId/corporateUserId.
// The row is kept permanently afterwards as the record of how/when they registered
// and their verified bank details — there's no separate bank-details store yet.
model CorporateRegistration {
  id                   Int       @id @default(autoincrement())
  corporateRefId       String    @unique @map("corporate_ref_id")
  company              Json
  bank                 Json
  documents            Json
  email                String
  emailVerified        Boolean   @default(false) @map("email_verified")
  emailVerifyToken     String?   @unique @map("email_verify_token")
  emailVerifyExpiresAt DateTime? @map("email_verify_expires_at")
  approved             Boolean   @default(false)
  approvedBy           Int?      @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  rejectedAt           DateTime? @map("rejected_at")
  rejectionReason      String?   @db.Text @map("rejection_reason")
  credentialsCreated   Boolean   @default(false) @map("credentials_created")
  corporateId          Int?      @map("corporate_id")
  corporateUserId      Int?      @map("corporate_user_id")
  // The applicant's mobile, taken from a verified Firebase phone sign-in (never from the
  // form) and fixed from then on. Null on registrations made before mobile verification
  // existed; those must be verified (legacy recovery) before they can be approved or
  // provisioned.
  mobileE164           String?   @db.VarChar(32) @map("mobile_e164")
  mobileVerifiedAt     DateTime? @map("mobile_verified_at")
  // Which Admin did what, kept on the row so it outlives the security-event retention.
  rejectedBy           Int?      @map("rejected_by")
  provisionedBy        Int?      @map("provisioned_by")
  provisionedAt        DateTime? @map("provisioned_at")
  // An Admin's review of a contact email that differs from the one originally submitted.
  emailReviewedBy      Int?      @map("email_reviewed_by")
  emailReviewedAt      DateTime? @map("email_reviewed_at")
  submittedAt          DateTime  @default(now()) @map("submitted_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([mobileE164])
  @@map("corporate_registrations")
}

// Ledger of Firebase phone sign-ins already used by a corporate flow. Firebase tokens carry
// no purpose and no unique id, so single use is enforced here: proofKey is the hash of the
// sign-in (uid + auth_time) and is UNIQUE, so a second insert of the same sign-in fails
// atomically. Rows must be kept at least as long as the proof freshness window; they are
// kept 90 days. No foreign keys, so the ledger never blocks anything else.
model PhoneProof {
  id             Int      @id @default(autoincrement())
  proofKey       String   @unique @db.Char(64) @map("proof_key")
  purpose        String   @db.VarChar(64) // "corporate_registration" | "corporate_registration_email_change" | "corporate_registration_legacy_mobile"
  phoneE164      String   @db.VarChar(32) @map("phone_e164")
  registrationId Int?     @map("registration_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([purpose, createdAt])
  @@index([registrationId])
  @@map("phone_proofs")
}

model Corporate {
  id                 Int      @id @default(autoincrement())
  companyName        String   @map("company_name")
  type               String   // "insurance" | "government" | "tpa" | "corporate"
  // Company-profile fields the corporate-portal web app's Profile page edits. All
  // optional since existing/admin-created corporates won't have these filled in yet.
  registrationNumber String?  @map("registration_number")
  companyType        String?  @map("company_type")
  country            String?
  state              String?
  city               String?
  address            String?  @db.Text
  pincode            String?
  officialEmail      String?  @map("official_email")
  officialPhone      String?  @map("official_phone")
  website            String?
  contactName        String?  @map("contact_name")
  contactDesignation String?  @map("contact_designation")
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  createdAt          DateTime @default(now()) @map("created_at")
  users              CorporateUser[]
  cases              Case[]
  tickets            SupportTicket[]
  documents          CorporateDocument[]

  @@map("corporates")
}

model SupportTicket {
  id          Int       @id @default(autoincrement())
  corporateId Int       @map("corporate_id")
  corporate   Corporate @relation(fields: [corporateId], references: [id])
  subject     String
  category    String?
  priority    String    @default("Medium") // "Low" | "Medium" | "High" | "Urgent"
  status      String    @default("open") // "open" | "in_progress" | "resolved" | "closed"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  messages    SupportTicketMessage[]

  @@index([corporateId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         Int           @id @default(autoincrement())
  ticketId   Int           @map("ticket_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorName String?       @map("author_name")
  authorRole String        @default("corporate") @map("author_role") // "corporate" | "admin"
  body       String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model CorporateUser {
  id           Int       @id @default(autoincrement())
  corporateId  Int       @map("corporate_id")
  corporate    Corporate @relation(fields: [corporateId], references: [id])
  email        String    @unique
  passwordHash String    @map("password_hash")
  // Free-form preferences bag for the corporate-portal web app's Settings page
  // (notification channels, language, timezone, date format, two-factor toggle) — a
  // JSON column since this is a flexible, evolving per-login preference set, not
  // something that needs to be queried/filtered on.
  settings     Json?
  // True for a login whose password someone else chose (the temporary password of a
  // provisioned Owner, or an Admin-added employee). While set, the session is limited to
  // changing the password; see requireAuth in auth.middleware.js.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("corporate_users")
}

model ServiceRequest {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  serviceType       String   @map("service_type")
  // The app's own id for the chosen service (e.g. "commercialair_stretcher"); the
  // Bitrix "Required Service" is looked up from this, never from the display name.
  serviceKey        String?  @map("service_key")
  patientName       String   @map("patient_name")
  patientAge        Int?     @map("patient_age")
  patientGender     String?  @map("patient_gender")
  patientLocation   String?  @map("patient_location")
  patientContact    String?  @map("patient_contact")
  origin            String
  destination       String
  country           String?
  preferredDate     DateTime? @map("preferred_date")
  careLevel         String?   @map("care_level")
  description       String?   @db.Text
  medicalSummary    String?   @db.Text @map("medical_summary")
  additionalInfo    String?   @map("additional_info")
  specialRequirements String? @db.Text @map("special_requirements")
  // Mortal Remains only (patientName then holds the deceased's name): who is asking,
  // and where and when the death happened.
  deceasedRelation  String?   @map("deceased_relation")
  placeOfDeath      String?   @map("place_of_death")
  dateOfDeath       DateTime? @map("date_of_death")
  referralSource    String?   @map("referral_source")
  documentUrl       String?   @map("document_url")
  referenceNumber   String    @unique @map("reference_number")
  status            String    @default("submitted")
  bitrixLeadId      Int?      @map("bitrix_lead_id")
  bitrixSyncAttempts Int      @default(0) @map("bitrix_sync_attempts")
  bitrixLastError   String?   @db.Text @map("bitrix_last_error")
  bitrixSyncFailedAt DateTime? @map("bitrix_sync_failed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  case              Case?

  @@map("service_requests")
}

// A Case is the corporate/ops-side tracking record for a request once it's being worked.
// Most Cases originate from a patient's ServiceRequest, but a corporate can also open one
// directly (e.g. a TPA filing on a member's behalf) — hence serviceRequestId is optional.
model Case {
  id                  Int       @id @default(autoincrement())
  serviceRequestId    Int?      @unique @map("service_request_id")
  serviceRequest      ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  corporateId         Int?      @map("corporate_id")
  corporate           Corporate? @relation(fields: [corporateId], references: [id])
  referenceNumber     String    @unique @map("reference_number")
  patientName         String    @map("patient_name")
  patientAge          Int?      @map("patient_age")
  patientGender       String?   @map("patient_gender")
  patientContact      String?   @map("patient_contact")
  serviceType         String    @map("service_type")
  origin              String
  destination         String
  country             String?
  urgency             String?   @default("routine") // "routine" | "urgent" | "critical"
  policyReference      String?  @map("policy_reference")
  // Mirrors the patient-facing ServiceRequest's equivalent fields (see above) so the
  // corporate-portal's "Request a Service" form can capture the same information the
  // mobile app's request flow does, not just a bare name/origin/destination.
  careLevel           String?   @map("care_level") // comma-joined care-level keys, same convention as ServiceRequest
  description         String?   @db.Text // "what do you need" — free text from the requester
  additionalInfo      String?   @db.Text @map("additional_info")
  specialRequirements String?   @db.Text @map("special_requirements")
  referralSource      String?   @map("referral_source")
  notes               String?   @db.Text
  status              String    @default("submitted") // "submitted" | "scheduled" | "in_progress" | "completed" | "cancelled"
  // Same Bitrix24 sync tracking as ServiceRequest, for cases the corporate-portal
  // submits directly (those never go through ServiceRequest, so they need their own
  // copy of these columns rather than sharing that model's).
  bitrixLeadId        Int?      @map("bitrix_lead_id")
  bitrixSyncAttempts  Int       @default(0) @map("bitrix_sync_attempts")
  bitrixLastError     String?   @db.Text @map("bitrix_last_error")
  bitrixSyncFailedAt  DateTime? @map("bitrix_sync_failed_at")
  // Billing — step 1 of a real billing system: a plain record Ops/Finance fills in by
  // hand per case. There's no payment gateway yet, so "paid" just means Finance marked
  // it so after actually getting paid outside the app (bank transfer against the
  // invoice) — see corporate-registration's bank details for where that money lands.
  billingAmount       Decimal?  @db.Decimal(10, 2) @map("billing_amount")
  billingCurrency     String?   @map("billing_currency") // ISO 4217, e.g. "INR", "AED", "USD"
  billingStatus       String    @default("pending") @map("billing_status") // "pending" | "invoiced" | "paid" | "overdue"
  billingInvoicedAt   DateTime? @map("billing_invoiced_at")
  billingPaidAt       DateTime? @map("billing_paid_at")
  billingNotes        String?   @db.Text @map("billing_notes")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  stageEvents         CaseStageEvent[]
  documents           Document[]
  communications      CaseCommunication[]

  @@index([corporateId, status])
  @@map("cases")
}

// A log of a corporate's contact with the patient about this case (a call, an email, a
// portal note) — the corporate-portal web app calls this a "patient communication," but
// since each of its "patients" is really just the patient-facing view of one Case
// (see corporate-portal.service.js), it's keyed directly off caseId, not a separate
// patient entity.
model CaseCommunication {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  case       Case     @relation(fields: [caseId], references: [id])
  channel    String
  summary    String   @db.Text
  authorName String?  @map("author_name")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([caseId])
  @@map("case_communications")
}

model CaseStageEvent {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  case       Case     @relation(fields: [caseId], references: [id])
  stage      String
  note       String?  @db.Text
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([caseId])
  @@map("case_stage_events")
}

model Document {
  id            Int      @id @default(autoincrement())
  caseId        Int      @map("case_id")
  case          Case     @relation(fields: [caseId], references: [id])
  // Nullable — the original "attach medical report while submitting a request" upload
  // never set this, so older rows won't have it. New uploads (see
  // cases.controller.js#uploadCaseDocument) always set one.
  type          String?
  name          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@index([caseId])
  @@map("documents")
}

// Company-level compliance documents (registration certificate, GST, PAN, etc.) — a
// corporate uploading these to its own profile, not tied to any one case. Deliberately
// has no status/verification field: that review workflow isn't built, so this just
// stores and lists what was uploaded rather than pretending to track Verified/Pending/
// Expired/Rejected state nobody is actually setting.
model CorporateDocument {
  id            Int      @id @default(autoincrement())
  corporateId   Int      @map("corporate_id")
  corporate     Corporate @relation(fields: [corporateId], references: [id])
  type          String
  name          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@index([corporateId])
  @@map("corporate_documents")
}

model Notification {
  id            Int       @id @default(autoincrement())
  recipientType String    @map("recipient_type") // "patient" | "corporate_user"
  recipientId   Int       @map("recipient_id")
  kind          String    @default("system") // "stage_update" | "quotation_ready" | "document" | "system"
  title         String
  body          String?   @db.Text
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([recipientType, recipientId, readAt])
  @@map("notifications")
}
