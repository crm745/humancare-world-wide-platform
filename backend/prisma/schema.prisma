// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  // The Create Account form asks for these two. `name` stays the full name ("first last") that
  // the rest of the app shows and sends; these are null for accounts made before the split and
  // for Google/Apple sign-ups, whose provider only gives one name. Nothing splits `name` to fill
  // them in, because that would be a guess.
  firstName    String?  @db.VarChar(50) @map("first_name")
  lastName     String?  @db.VarChar(50) @map("last_name")
  email        String   @unique
  // E.164 (e.g. "+919876543210") so the same number can't be stored two ways.
  mobile       String?  @unique
  countryCode  String   @default("+91") @map("country_code")
  // Asked on the sign-up form; null for accounts made before it did. Personal data: never
  // written to a log.
  gender       String?  @db.VarChar(20) // "male" | "female" | "other" | "prefer_not_to_say"
  nationality  String?  @db.VarChar(2) // ISO 3166-1 alpha-2 code, e.g. "IN"
  // The country picked for the phone's calling code. countryCode above is only the code
  // ("+1"), which several countries share, so this says which one it was.
  phoneCountry String?  @db.VarChar(2) @map("phone_country")
  // Null for accounts created before passwords were introduced (OTP-only) and for
  // Google/Apple accounts — the login flow makes the former set one on next login.
  passwordHash String?  @map("password_hash")
  // False only between password registration and its OTP check; social and older
  // accounts were already verified when they were created.
  isVerified   Boolean  @default(true) @map("is_verified")
  // Set once the person proves they own the email (OTP at sign-up or on change, or the
  // provider vouching for it on Google/Apple sign-in). Google/Apple only ever link to
  // an existing account whose email is verified.
  emailVerifiedAt DateTime? @map("email_verified_at")
  failedLoginCount Int  @default(0) @map("failed_login_count")
  lockedUntil  DateTime? @map("locked_until")
  // Baked into every token; bumping it (password reset) kills existing sessions.
  tokenVersion Int      @default(0) @map("token_version")
  googleId     String?  @unique @map("google_id")
  appleId      String?  @unique @map("apple_id")
  pushToken    String?  @map("push_token")
  createdAt    DateTime @default(now()) @map("created_at")
  requests     ServiceRequest[]
  consents     UserConsent[]
  // Phase 2: quotations this patient accepted or rejected (the decision evidence lives on the quotation row).
  quotationDecisions CaseQuotation[] @relation("QuotationDecider")

  @@map("users")
}

// What the patient agreed to at sign-up, kept as proof (who, what, which wording, when,
// from where). One row per consent; the optional marketing one is stored either way so
// a "no" is on record too.
model UserConsent {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  // A half-finished sign-up that gets replaced takes its consent rows with it.
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "terms_privacy" | "medical_disclaimer" | "marketing"
  accepted   Boolean
  // Which wording was shown (CONSENT_VERSION in auth.controller.js); bump it whenever
  // the consent text in the app changes.
  version    String
  ipAddress  String?  @map("ip_address")
  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@index([userId])
  @@map("user_consents")
}

// Audit trail of account security events: sign-ups, logins, failures, lockouts, password
// and contact changes. Never holds a password or OTP; typed identifiers are stored
// masked. No foreign key on purpose: the history outlives a deleted account.
model SecurityEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  event      String   // see EVENTS in modules/auth/security-events.js
  identifier String?  // masked mobile/email that was typed, e.g. "+91 •••••3210"
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @db.VarChar(255) @map("user_agent")
  detail     Json?
  // Who performed the action, when it isn't a patient (userId is patient-only): an Admin
  // reviewing a corporate registration, the registrant themselves, or the system. Null on
  // patient rows, so existing history is untouched.
  actorType  String?  @db.VarChar(16) @map("actor_type") // "admin" | "registrant" | "system"
  actorId    Int?     @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("security_events")
}

model OtpCode {
  id         Int       @id @default(autoincrement())
  identifier String    // mobile number or email, depending on purpose
  codeHash   String    @map("code_hash")
  purpose    String    // "patient_register" | "patient_register_email" | "patient_login" | "patient_password_reset" | "patient_change_mobile" | "patient_change_email" | "corporate_login" | "corporate_password_reset"
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("otp_codes")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // Null while the account is only invited and has not chosen a password yet. Login code
  // must treat null as "cannot sign in with a password", never pass it to bcrypt.
  passwordHash String?  @map("password_hash")
  // "admin" handles day-to-day ops (cases, patients, corporates, tickets); "superadmin"
  // additionally manages other admin accounts and sensitive settings (the services
  // catalog today, billing later) — see requireSuperAdmin in auth.middleware.js.
  role         String   @default("admin")
  // Lets a regular admin review corporate registrations (list, approve, reject, provision).
  // Superadmins can always do so. Granted by a server-side script, never by the request.
  corporateReview Boolean @default(false) @map("corporate_review")
  // "invited" | "pending_passkey" | "active" | "disabled". Accounts that existed before the
  // Admin Lock System are "active". Admins are soft-disabled, never deleted.
  status       String   @default("active") @db.VarChar(24)
  emailVerifiedAt   DateTime? @map("email_verified_at")
  // Failed password AND passkey attempts share this counter; it is reset only after both
  // factors have succeeded.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt       DateTime? @map("last_login_at")
  disabledAt        DateTime? @map("disabled_at")
  disabledReason    String?   @db.VarChar(255) @map("disabled_reason")
  // The Admin who disabled this account. A plain id with no foreign key, like the other
  // "by" columns; the history must survive whatever happens to the referenced row.
  disabledBy        Int?      @map("disabled_by")
  createdAt    DateTime @default(now()) @map("created_at")
  // Existing rows get the time of the migration; it is maintained by Prisma from then on.
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  invitations       AdminInvitation[]
  sessions          AdminSession[]
  passkeys          AdminPasskey[]
  challenges        AdminWebAuthnChallenge[]
  recoveryTargets   AdminRecoveryRequest[]  @relation("RecoveryTarget")
  recoveryRequested AdminRecoveryRequest[]  @relation("RecoveryRequester")
  recoveryApprovals AdminRecoveryApproval[] @relation("RecoveryApprover")
  // Phase 2 quotation workflow. Real foreign keys (RESTRICT): Admins are soft-disabled, never deleted.
  quotationsConfirmed       CaseQuotation[] @relation("QuotationConfirmer")
  quotationsPublished       CaseQuotation[] @relation("QuotationPublisher")
  quotationsWithdrawn       CaseQuotation[] @relation("QuotationWithdrawer")
  invoicesPartialAuthorized Invoice[]       @relation("InvoicePartialAuthorizer")

  @@index([status])
  @@map("admin_users")
}

// A request to regain access after losing every passkey. Normal recovery needs approval
// from two different active Admins with the "superadmin" role; neither the target nor the
// requester may approve (enforced in code, in one transaction). Kept permanently as security
// history, so nothing that references it can be deleted.
model AdminRecoveryRequest {
  id                 Int       @id @default(autoincrement())
  // The Admin who lost the passkey.
  adminId            Int       @map("admin_id")
  admin              AdminUser @relation("RecoveryTarget", fields: [adminId], references: [id], onDelete: Restrict)
  // The authenticated Admin who filed it. Null when it was not filed by a signed-in Admin
  // (a self-service request from the target's mailbox, or a server operator).
  requestedByAdminId Int?      @map("requested_by_admin_id")
  requestedBy        AdminUser? @relation("RecoveryRequester", fields: [requestedByAdminId], references: [id], onDelete: Restrict)
  requestedVia       String    @db.VarChar(16) @map("requested_via")
  requestIp          String?   @map("request_ip")
  reason             String?   @db.VarChar(500)
  status             String    @default("pending") @db.VarChar(24) // "pending" | "approved" | "completed" | "rejected" | "expired" | "cancelled"
  approvalsRequired  Int       @default(2) @map("approvals_required")
  approvedAt         DateTime? @map("approved_at")
  expiresAt          DateTime  @map("expires_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  approvals          AdminRecoveryApproval[]
  invitations        AdminInvitation[]
  challenges         AdminWebAuthnChallenge[]

  @@index([adminId, status])
  @@index([status, expiresAt])
  @@index([requestedByAdminId])
  @@map("admin_recovery_requests")
}

// The emailed, single-use link that activates an account or enrols / recovers a passkey.
// Only a SHA-256 hash of the token is stored, never the token. Kept permanently.
model AdminInvitation {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  purpose           String    @db.VarChar(24) // "activation" | "passkey_enrollment" | "passkey_recovery"
  // Set for a normal passkey recovery. Null for the other purposes, and for break-glass
  // recovery issued through the separately authorised emergency path.
  recoveryRequestId Int?      @map("recovery_request_id")
  recoveryRequest   AdminRecoveryRequest? @relation(fields: [recoveryRequestId], references: [id], onDelete: Restrict)
  tokenHash         String    @unique @db.Char(64) @map("token_hash")
  // The address the link was sent to, as it was at the time.
  sentToEmail       String    @map("sent_to_email")
  expiresAt         DateTime  @map("expires_at")
  usedAt            DateTime? @map("used_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  challenges        AdminWebAuthnChallenge[]

  @@index([adminId, createdAt])
  @@index([expiresAt])
  @@index([recoveryRequestId])
  @@map("admin_invitations")
}

// A signed-in dashboard session, checked against this row on every request. At most two are
// active per Admin (enforced in code under a row lock on admin_users). It locks after 30
// minutes idle and ends at the absolute limit; both times are fixed when it is created or
// last used. History is kept 365 days after expiry/revocation.
model AdminSession {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  // When the session locks for inactivity (lastActivityAt + 30 minutes), not when it ends.
  idleExpiresAt     DateTime  @map("idle_expires_at")
  // When the session ends regardless of activity (createdAt + 7 days).
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  lockedAt          DateTime? @map("locked_at")
  // Failed passkey unlock attempts on this session, tracked apart from the account counter.
  unlockFailedCount Int       @default(0) @map("unlock_failed_count")
  unlockLockedUntil DateTime? @map("unlock_locked_until")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @db.VarChar(64) @map("revoked_reason")
  // The Admin who revoked it; null when the system or a server operator did.
  revokedBy         Int?      @map("revoked_by")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @db.VarChar(255) @map("user_agent")
  refreshTokens     AdminRefreshToken[]
  challenges        AdminWebAuthnChallenge[]

  @@index([adminId, revokedAt, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("admin_sessions")
}

// One refresh token of a session. Each use rotates it: the used token is marked and points at
// its replacement, and presenting a used token again revokes the whole session. Only the
// SHA-256 hash is stored. Rows are kept (not deleted) when a session is revoked; they are
// purged with their session, children first.
model AdminRefreshToken {
  id           Int          @id @default(autoincrement())
  sessionId    Int          @map("session_id")
  session      AdminSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash    String       @unique @db.Char(64) @map("token_hash")
  expiresAt    DateTime     @map("expires_at")
  usedAt       DateTime?    @map("used_at")
  // The token that replaced this one when it was used. SET NULL (not Restrict) so the
  // retention purge can remove old tokens without deleting them in chain order.
  replacedById Int?         @unique @map("replaced_by_id")
  replacedBy   AdminRefreshToken? @relation("RefreshChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AdminRefreshToken? @relation("RefreshChain")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}

// A registered WebAuthn credential. Only the public key is stored. The credential id is
// case-sensitive but this database's collation is not, so lookups use credentialIdHash (a
// SHA-256 hex digest) and the raw id is kept as bytes.
model AdminPasskey {
  id               Int       @id @default(autoincrement())
  adminId          Int       @map("admin_id")
  admin            AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  credentialIdHash String    @unique @db.Char(64) @map("credential_id_hash")
  credentialId     Bytes     @map("credential_id")
  publicKey        Bytes     @map("public_key")
  signCount        Int       @default(0) @db.UnsignedInt @map("sign_count")
  transports       Json?
  aaguid           String?   @db.VarChar(36)
  deviceType       String?   @db.VarChar(16) @map("device_type")
  backedUp         Boolean?  @map("backed_up")
  label            String?   @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @db.VarChar(64) @map("revoked_reason")
  // The Admin who revoked it; null when a server operator did.
  revokedBy        Int?      @map("revoked_by")

  @@index([adminId, revokedAt])
  @@map("admin_passkeys")
}

// One Admin's decision on a recovery request. UNIQUE (request, approver) so nobody decides
// twice; that the approver is an active "superadmin" and is neither the target nor the
// requester is checked in code, in the same transaction that completes the recovery.
model AdminRecoveryApproval {
  id           Int       @id @default(autoincrement())
  requestId    Int       @map("request_id")
  request      AdminRecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approverId   Int       @map("approver_id")
  approver     AdminUser @relation("RecoveryApprover", fields: [approverId], references: [id], onDelete: Restrict)
  // The approver's role at the moment of the decision.
  approverRole String    @db.VarChar(16) @map("approver_role")
  decision     String    @db.VarChar(16) // "approved" | "rejected"
  reason       String?   @db.VarChar(500)
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([requestId, approverId])
  @@index([approverId])
  @@map("admin_recovery_approvals")
}

// A single-use WebAuthn challenge, bound to what it was issued for: an invitation
// (registration), a recovery request (recovery_registration), or a session (unlock; a
// registration from a signed-in session also binds here). Short-lived (2 minutes) and
// cleaned up after it expires, so unlike the durable tables it cascades from the Admin.
model AdminWebAuthnChallenge {
  id                Int       @id @default(autoincrement())
  adminId           Int       @map("admin_id")
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  purpose           String    @db.VarChar(32) // "registration" | "authentication" | "unlock" | "recovery_registration"
  challenge         String    @db.VarChar(191)
  invitationId      Int?      @map("invitation_id")
  invitation        AdminInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  recoveryRequestId Int?      @map("recovery_request_id")
  recoveryRequest   AdminRecoveryRequest? @relation(fields: [recoveryRequestId], references: [id], onDelete: SetNull)
  sessionId         Int?      @map("session_id")
  session           AdminSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([adminId, purpose, consumedAt])
  @@index([expiresAt])
  @@index([invitationId])
  @@index([recoveryRequestId])
  @@index([sessionId])
  @@map("admin_webauthn_challenges")
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  subtitle    String?
  description String?  @db.Text
  provides    Json?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// A pending corporate-partner application — the corporate-portal's /register wizard
// (company → bank → documents → mobile verified by Firebase → email verify → HumanCare
// approval → Admin provisions the initial Owner).
// company/bank are stored as submitted (not yet a real Corporate row); once an authorised
// Admin approves it and then provisions the Owner, a real Corporate + CorporateUser are
// created and linked back here via corporateId/corporateUserId.
// The row is kept permanently afterwards as the record of how/when they registered
// and their verified bank details — there's no separate bank-details store yet.
model CorporateRegistration {
  id                   Int       @id @default(autoincrement())
  corporateRefId       String    @unique @map("corporate_ref_id")
  company              Json
  bank                 Json
  documents            Json
  email                String
  emailVerified        Boolean   @default(false) @map("email_verified")
  emailVerifyToken     String?   @unique @map("email_verify_token")
  emailVerifyExpiresAt DateTime? @map("email_verify_expires_at")
  approved             Boolean   @default(false)
  approvedBy           Int?      @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  rejectedAt           DateTime? @map("rejected_at")
  rejectionReason      String?   @db.Text @map("rejection_reason")
  credentialsCreated   Boolean   @default(false) @map("credentials_created")
  corporateId          Int?      @map("corporate_id")
  corporateUserId      Int?      @map("corporate_user_id")
  // The applicant's mobile, taken from a verified Firebase phone sign-in (never from the
  // form) and fixed from then on. Null on registrations made before mobile verification
  // existed; those must be verified (legacy recovery) before they can be approved or
  // provisioned.
  mobileE164           String?   @db.VarChar(32) @map("mobile_e164")
  mobileVerifiedAt     DateTime? @map("mobile_verified_at")
  // Which Admin did what, kept on the row so it outlives the security-event retention.
  rejectedBy           Int?      @map("rejected_by")
  provisionedBy        Int?      @map("provisioned_by")
  provisionedAt        DateTime? @map("provisioned_at")
  // An Admin's review of a contact email that differs from the one originally submitted.
  emailReviewedBy      Int?      @map("email_reviewed_by")
  emailReviewedAt      DateTime? @map("email_reviewed_at")
  submittedAt          DateTime  @default(now()) @map("submitted_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([mobileE164])
  @@map("corporate_registrations")
}

// Ledger of Firebase phone sign-ins already used by a corporate flow. Firebase tokens carry
// no purpose and no unique id, so single use is enforced here: proofKey is the hash of the
// sign-in (uid + auth_time) and is UNIQUE, so a second insert of the same sign-in fails
// atomically. Rows must be kept at least as long as the proof freshness window; they are
// kept 90 days. No foreign keys, so the ledger never blocks anything else.
model PhoneProof {
  id             Int      @id @default(autoincrement())
  proofKey       String   @unique @db.Char(64) @map("proof_key")
  purpose        String   @db.VarChar(64) // "corporate_registration" | "corporate_registration_email_change" | "corporate_registration_legacy_mobile"
  phoneE164      String   @db.VarChar(32) @map("phone_e164")
  registrationId Int?     @map("registration_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([purpose, createdAt])
  @@index([registrationId])
  @@map("phone_proofs")
}

model Corporate {
  id                 Int      @id @default(autoincrement())
  companyName        String   @map("company_name")
  type               String   // "insurance" | "government" | "tpa" | "corporate"
  // Company-profile fields the corporate-portal web app's Profile page edits. All
  // optional since existing/admin-created corporates won't have these filled in yet.
  registrationNumber String?  @map("registration_number")
  companyType        String?  @map("company_type")
  country            String?
  state              String?
  city               String?
  address            String?  @db.Text
  pincode            String?
  officialEmail      String?  @map("official_email")
  officialPhone      String?  @map("official_phone")
  website            String?
  contactName        String?  @map("contact_name")
  contactDesignation String?  @map("contact_designation")
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  createdAt          DateTime @default(now()) @map("created_at")
  users              CorporateUser[]
  cases              Case[]
  tickets            SupportTicket[]
  documents          CorporateDocument[]

  @@map("corporates")
}

model SupportTicket {
  id          Int       @id @default(autoincrement())
  corporateId Int       @map("corporate_id")
  corporate   Corporate @relation(fields: [corporateId], references: [id])
  subject     String
  category    String?
  priority    String    @default("Medium") // "Low" | "Medium" | "High" | "Urgent"
  status      String    @default("open") // "open" | "in_progress" | "resolved" | "closed"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  messages    SupportTicketMessage[]

  @@index([corporateId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         Int           @id @default(autoincrement())
  ticketId   Int           @map("ticket_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorName String?       @map("author_name")
  authorRole String        @default("corporate") @map("author_role") // "corporate" | "admin"
  body       String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model CorporateUser {
  id           Int       @id @default(autoincrement())
  corporateId  Int       @map("corporate_id")
  corporate    Corporate @relation(fields: [corporateId], references: [id])
  email        String    @unique
  passwordHash String    @map("password_hash")
  // Free-form preferences bag for the corporate-portal web app's Settings page
  // (notification channels, language, timezone, date format, two-factor toggle) — a
  // JSON column since this is a flexible, evolving per-login preference set, not
  // something that needs to be queried/filtered on.
  settings     Json?
  // True for a login whose password someone else chose (the temporary password of a
  // provisioned Owner, or an Admin-added employee). While set, the session is limited to
  // changing the password; see requireAuth in auth.middleware.js.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("corporate_users")
}

model ServiceRequest {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  serviceType       String   @map("service_type")
  // The app's own id for the chosen service (e.g. "commercialair_stretcher"); the
  // Bitrix "Required Service" is looked up from this, never from the display name.
  serviceKey        String?  @map("service_key")
  patientName       String   @map("patient_name")
  patientAge        Int?     @map("patient_age")
  patientGender     String?  @map("patient_gender")
  patientLocation   String?  @map("patient_location")
  patientContact    String?  @map("patient_contact")
  origin            String
  destination       String
  country           String?
  // A calendar day, no time of day (SQL DATE). Written as a "YYYY-MM-DD" date at 00:00 UTC, which
  // Prisma stores as exactly that day and reads back as 00:00 UTC of it: never shifted by a timezone.
  preferredDate     DateTime? @map("preferred_date") @db.Date
  careLevel         String?   @map("care_level")
  description       String?   @db.Text
  // Mortal Remains only (patientName then holds the deceased's name): who is asking,
  // and where and when the death happened.
  deceasedRelation  String?   @map("deceased_relation")
  placeOfDeath      String?   @map("place_of_death")
  dateOfDeath       DateTime? @map("date_of_death")
  // The medical page of the New Request form. Mobility and the equipment flags are only set
  // for patient-transport services (null otherwise, and on requests made before the page
  // existed); urgency is null on those older requests too.
  mobility          String?   @db.VarChar(191) // one or more of "bedridden" | "wheelchair" | "walking", joined with commas (Private Charter is multi-select)
  equipOxygen       Boolean?  @map("equip_oxygen")
  equipCardiacMonitor Boolean? @map("equip_cardiac_monitor")
  equipVentilator   Boolean?  @map("equip_ventilator")
  urgency           String?   @db.VarChar(16) // "critical_6h" | "urgent_24h" | "planned"
  // Private Charter only (null for every other service and for older requests): the cities the
  // patient picked, as the server verified them against the GeoNames table (geonames_cities).
  // `origin` / `destination` above keep the readable label ("Mumbai, Maharashtra, India") that
  // every other part of the system shows. The timezone is the origin city's own, as used for the
  // "no past date" check.
  originGeonameId       Int?    @map("origin_geoname_id")
  originCityName        String? @db.VarChar(200) @map("origin_city_name")
  originCountryCode     String? @db.VarChar(2) @map("origin_country_code")
  originTimezone        String? @db.VarChar(64) @map("origin_timezone")
  destinationGeonameId  Int?    @map("destination_geoname_id")
  destinationCityName   String? @db.VarChar(200) @map("destination_city_name")
  destinationCountryCode String? @db.VarChar(2) @map("destination_country_code")
  referenceNumber   String    @unique @map("reference_number")
  status            String    @default("submitted")
  bitrixLeadId      Int?      @map("bitrix_lead_id")
  bitrixSyncAttempts Int      @default(0) @map("bitrix_sync_attempts")
  bitrixLastError   String?   @db.Text @map("bitrix_last_error")
  bitrixSyncFailedAt DateTime? @map("bitrix_sync_failed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  case              Case?

  // Request-first review workflow (Private Charter only; see backend/REQUEST-REVIEW-WORKFLOW.md).
  // NULL on every older request and on every other service: those keep the original flow, where a
  // Case is created together with the request. Otherwise one of: "awaiting_documents" (nothing
  // uploaded yet), "in_review", "changes_requested" (an Admin asked for more or rejected a
  // document), "approved" (the Case exists). The Case is created only on approval.
  reviewStatus           String?   @map("review_status") @db.VarChar(24)
  // When the first document arrived (the request then entered review).
  submittedAt            DateTime? @map("submitted_at")
  reviewedAt             DateTime? @map("reviewed_at")
  // What the patient is told to provide next. Shown to the patient, so never an internal note.
  documentsRequestReason String?   @db.Text @map("documents_request_reason")
  requestDocuments       RequestDocument[]
  requestEvents          RequestEvent[]

  @@index([reviewStatus, createdAt])
  @@map("service_requests")
}

// One file a patient uploaded against a request in the review workflow. The file stays on disk and
// every row is kept for good: a replaced or rejected document is marked, never deleted, so the
// history of what was sent and decided survives. Nothing here is downloadable until scan_status is
// "clean" (see request-review.service.js).
model RequestDocument {
  id                Int      @id @default(autoincrement())
  serviceRequestId  Int      @map("service_request_id")
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  originalName      String   @map("original_name")
  // The file's name inside the uploads folder. Never sent to a client.
  storageKey        String   @unique @map("storage_key")
  sizeBytes         Int      @map("size_bytes")
  mimeType          String?  @map("mime_type")
  sha256            String?  @db.Char(64)
  uploadedByUserId  Int      @map("uploaded_by_user_id")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  // The earlier document this one replaces (a plain id: the old row is kept as it was).
  replacesId        Int?     @map("replaces_id")
  supersededAt      DateTime? @map("superseded_at")
  // "pending" | "clean" | "infected" | "error". Only an explicit "OK" from ClamAV is "clean".
  scanStatus        String   @default("pending") @map("scan_status") @db.VarChar(16)
  scanEngine        String?  @map("scan_engine") @db.VarChar(40)
  scanDetail        String?  @map("scan_detail") @db.VarChar(255)
  scannedAt         DateTime? @map("scanned_at")
  // Retry bookkeeping of the scan worker. Attempts are counted when an attempt is claimed (a crash
  // mid-scan still uses one); NULL next-attempt = due now; while an attempt runs it is the lease end.
  scanAttempts      Int      @default(0) @map("scan_attempts")
  scanNextAttemptAt DateTime? @map("scan_next_attempt_at")
  // "pending" | "approved" | "rejected"
  reviewStatus      String   @default("pending") @map("review_status") @db.VarChar(16)
  reviewedByAdminId Int?     @map("reviewed_by_admin_id")
  reviewedAt        DateTime? @map("reviewed_at")
  // Shown to the patient.
  rejectionReason   String?  @db.Text @map("rejection_reason")
  // The documents row created for it when the request was approved (a plain id).
  caseDocumentId    Int?     @unique @map("case_document_id")
  // The Admin / Operations document request this upload answers (M4). NULL on every existing row and
  // on a document the patient uploaded unprompted. Never required: an upload is valid without it.
  documentRequestId Int?     @map("document_request_id")
  documentRequest   DocumentRequest? @relation(fields: [documentRequestId], references: [id], onDelete: Restrict)
  dealShares        BitrixDealDocument[]

  @@index([documentRequestId])
  @@index([serviceRequestId])
  @@index([scanStatus])
  @@index([scanStatus, scanNextAttemptAt])
  @@map("request_documents")
}

// Append-only business audit history of a request: uploads, scan results, review decisions,
// requests for more documents, replacements, approval. Rows are only ever inserted (nothing in the
// code updates or deletes one) and are not covered by any purge job. Deliberately not
// security_events, which is a security log with a 365-day retention.
model RequestEvent {
  id               Int      @id @default(autoincrement())
  serviceRequestId Int      @map("service_request_id")
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  documentId       Int?     @map("document_id")
  action           String   @db.VarChar(40)
  fromStatus       String?  @map("from_status") @db.VarChar(24)
  toStatus         String?  @map("to_status") @db.VarChar(24)
  // "patient" | "admin" | "system"
  actorType        String   @map("actor_type") @db.VarChar(12)
  actorId          Int?     @map("actor_id")
  detail           Json?
  occurredAt       DateTime @default(now()) @map("occurred_at")

  @@index([serviceRequestId, occurredAt])
  @@map("request_events")
}

// A Case is the corporate/ops-side tracking record for a request once it's being worked.
// Most Cases originate from a patient's ServiceRequest, but a corporate can also open one
// directly (e.g. a TPA filing on a member's behalf) — hence serviceRequestId is optional.
model Case {
  id                  Int       @id @default(autoincrement())
  serviceRequestId    Int?      @unique @map("service_request_id")
  // M9: RESTRICT on delete (was SET NULL): a service request that has a Case cannot be deleted, so the Case/Deal
  // history is never silently detached. Corporate Cases keep serviceRequestId NULL, which a foreign key never checks.
  serviceRequest      ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corporateId        Int?      @map("corporate_id")
  corporate           Corporate? @relation(fields: [corporateId], references: [id])
  referenceNumber     String    @unique @map("reference_number")
  patientName         String    @map("patient_name")
  patientAge          Int?      @map("patient_age")
  patientGender       String?   @map("patient_gender")
  patientContact      String?   @map("patient_contact")
  serviceType         String    @map("service_type")
  origin              String
  destination         String
  country             String?
  urgency             String?   @default("routine") // "routine" | "urgent" | "critical"
  policyReference      String?  @map("policy_reference")
  // Mirrors the patient-facing ServiceRequest's equivalent fields (see above) so the
  // corporate-portal's "Request a Service" form can capture the same information the
  // mobile app's request flow does, not just a bare name/origin/destination.
  careLevel           String?   @map("care_level") // comma-joined care-level keys, same convention as ServiceRequest
  description         String?   @db.Text // "what do you need" — free text from the requester
  additionalInfo      String?   @db.Text @map("additional_info")
  specialRequirements String?   @db.Text @map("special_requirements")
  referralSource      String?   @map("referral_source")
  notes               String?   @db.Text
  status              String    @default("submitted") // "submitted" | "scheduled" | "in_progress" | "completed" | "cancelled"
  // Same Bitrix24 sync tracking as ServiceRequest, for cases the corporate-portal
  // submits directly (those never go through ServiceRequest, so they need their own
  // copy of these columns rather than sharing that model's).
  bitrixLeadId        Int?      @map("bitrix_lead_id")
  bitrixSyncAttempts  Int       @default(0) @map("bitrix_sync_attempts")
  bitrixLastError     String?   @db.Text @map("bitrix_last_error")
  bitrixSyncFailedAt  DateTime? @map("bitrix_sync_failed_at")
  // Billing — step 1 of a real billing system: a plain record Ops/Finance fills in by
  // hand per case. There's no payment gateway yet, so "paid" just means Finance marked
  // it so after actually getting paid outside the app (bank transfer against the
  // invoice) — see corporate-registration's bank details for where that money lands.
  billingAmount       Decimal?  @db.Decimal(10, 2) @map("billing_amount")
  billingCurrency     String?   @map("billing_currency") // ISO 4217, e.g. "INR", "AED", "USD"
  billingStatus       String    @default("pending") @map("billing_status") // "pending" | "invoiced" | "paid" | "overdue"
  billingInvoicedAt   DateTime? @map("billing_invoiced_at")
  billingPaidAt       DateTime? @map("billing_paid_at")
  billingNotes        String?   @db.Text @map("billing_notes")
  // Private Charter stage tracking (M1). NULL on every existing Case and on every Corporate Case.
  // Separate from `status` above, whose values and meaning are unchanged.
  charterStage        String?   @map("charter_stage")
  stageVersion        Int       @default(0) @map("stage_version")
  closedAt            DateTime? @map("closed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  stageEvents         CaseStageEvent[]
  documents           Document[]
  communications      CaseCommunication[]
  auditLogs           AuditLog[]
  documentRequests    DocumentRequest[]
  bitrixDealLink      BitrixDealLink?
  outboxEvents        IntegrationOutbox[]
  invoices            Invoice[]
  quotations          CaseQuotation[] @relation("CaseToQuotation")

  @@index([corporateId, status])
  @@map("cases")
}

// A log of a corporate's contact with the patient about this case (a call, an email, a
// portal note) — the corporate-portal web app calls this a "patient communication," but
// since each of its "patients" is really just the patient-facing view of one Case
// (see corporate-portal.service.js), it's keyed directly off caseId, not a separate
// patient entity.
model CaseCommunication {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  case       Case     @relation(fields: [caseId], references: [id])
  channel    String
  summary    String   @db.Text
  authorName String?  @map("author_name")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([caseId])
  @@map("case_communications")
}

model CaseStageEvent {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  case       Case     @relation(fields: [caseId], references: [id])
  stage      String
  note       String?  @db.Text
  occurredAt DateTime @default(now()) @map("occurred_at")
  // Private Charter transition metadata (M2). NULL on every existing row and on rows written by the
  // Corporate / legacy paths, which only set stage, note and occurredAt.
  previousStage      String?   @map("previous_stage")
  actorType          String?   @map("actor_type")
  actorId            String?   @map("actor_id")
  source             String?
  reasonCode         String?   @map("reason_code")
  reasonText         String?   @db.Text @map("reason_text")
  idempotencyKey     String?   @map("idempotency_key")
  externalModifiedAt DateTime? @map("external_modified_at")

  @@unique([caseId, idempotencyKey])
  @@index([caseId])
  @@map("case_stage_events")
}

// Private Charter business audit history (M3): who did what, to which entity, from where and why,
// with the before and after values. Append-only: rows are only ever inserted (nothing in the code
// updates or deletes one), there is deliberately no updatedAt, and no purge job covers this table.
// Deliberately not security_events, which is a security log with a retention purge.
//
// Sensitive data: beforeData and afterData may hold only explicitly allowlisted audit fields (for
// example a stage, a status, an amount, an identifier). Medical content, reports, document contents,
// passwords, tokens, webhook URLs and any other secret must NEVER be stored in this table, in any
// column, reasonText included. Redaction and allowlist enforcement belong to the future audit-writing
// service, not to the database. Application-level append-only enforcement (a single write path with
// no update or delete) and database-account permissions (no UPDATE or DELETE for the application's
// account) belong to later implementation and deployment work; this table does not enforce them.
//
// Identifiers: entityId and idempotencyKey are opaque and are stored exactly as given (a Bitrix Deal
// ID, an invoice number, a client key). They are never trimmed, lowercased or otherwise changed. The
// audit-writing service MUST reject (not silently trim or transform) any entityId or idempotencyKey
// with leading or trailing whitespace, because utf8mb4_bin ignores trailing spaces when comparing and
// would otherwise treat "AbC" and "AbC " as the same identifier. The
// migration gives these two columns the case-sensitive utf8mb4_bin collation so "AbC" and "abc" are
// different identifiers, including inside the unique key below. Prisma's schema cannot express a
// column collation, so it is set in the migration SQL only.
// The Case link is RESTRICT: a Case that has audit history cannot be deleted.
model AuditLog {
  id             Int      @id @default(autoincrement())
  caseId         Int?     @map("case_id")
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  entityType     String   @db.VarChar(40) @map("entity_type") // "case" | "invoice" | "payment" | "bitrix_deal_link" | ...
  entityId       String   @db.VarChar(64) @map("entity_id")
  action         String   @db.VarChar(64)
  actorType      String   @db.VarChar(16) @map("actor_type") // "admin" | "operations" | "patient" | "system" | "bitrix"
  actorId        String?  @db.VarChar(64) @map("actor_id")
  actorRole      String?  @db.VarChar(32) @map("actor_role") // the actor's role at the time, e.g. "superadmin"
  source         String   @db.VarChar(32) // "admin_portal" | "mobile_app" | "bitrix_webhook" | "system" | ...
  isOverride     Boolean  @default(false) @map("is_override") // an Admin overrode the normal rules
  reasonCode     String?  @db.VarChar(64) @map("reason_code")
  reasonText     String?  @db.Text @map("reason_text")
  beforeData     Json?    @map("before_data")
  afterData      Json?    @map("after_data")
  correlationId  String?  @db.VarChar(64) @map("correlation_id") // groups the rows written by one action or request
  idempotencyKey String?  @db.VarChar(191) @map("idempotency_key")
  occurredAt     DateTime @default(now()) @map("occurred_at") // when the business event happened
  recordedAt     DateTime @default(now()) @map("recorded_at") // when HumanCare stored this audit entry

  @@unique([entityType, entityId, idempotencyKey])
  @@index([caseId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([actorType, actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

// PRIVATE CHARTER ONLY. DocumentRequest is intended for Private Charter Cases and nothing else. The
// Corporate document workflows (uploads, review, approval, downloads through the legacy documents
// table) are unchanged and never use this table. The database cannot tell the two kinds of Case
// apart, so the future service MUST, inside the same transaction that creates the row, load the Case
// and refuse (without creating anything) unless Case.serviceRequestId is set AND that ServiceRequest's
// serviceKey equals PRIVATE_CHARTER_KEY (common/constants/request.constants.js). A Corporate Case
// (serviceRequestId NULL) and a Case of any other service must be refused. This table has no relation
// to the legacy `Document` model and none may be added.
//
// A request from HumanCare (Admin or Operations) for one document from the patient (M4). It is NOT an
// uploaded document: the upload is a RequestDocument (the canonical, scanned, reviewed record), which
// may point back here through request_documents.document_request_id. A Case can have any number of
// requests, several of them open at once, and a request has no expiry date and nothing expires it:
// it stays open until someone fulfils or cancels it. Rows are kept for good (the Case link is RESTRICT)
// and are never deleted. The legacy single-slot ask (service_requests.documents_request_reason) is
// not touched and not backfilled into this table. description and reason are shown to the patient, so
// never an internal note, and never medical content or a secret. Writing rules (who may open or
// resolve a request, and the audit entries) belong to the future service, not to the database.
//
// idempotencyKey is an opaque client key: it is stored exactly as given and compared case-sensitively
// (the migration gives the column utf8mb4_bin; Prisma's schema cannot express a column collation).
// utf8mb4_bin ignores trailing spaces when comparing, so the future service MUST reject (never silently
// trim or transform) an idempotencyKey with leading or trailing whitespace.
model DocumentRequest {
  id              Int       @id @default(autoincrement())
  caseId          Int       @map("case_id")
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  documentType    String?   @db.VarChar(64) @map("document_type") // optional category, e.g. "medical_report", "passport"
  description     String    @db.Text // what is being asked for
  reason          String?   @db.Text // why it is needed
  status          String    @default("open") @db.VarChar(24) // "open" | "fulfilled" | "cancelled"
  requestedByType String    @db.VarChar(16) @map("requested_by_type") // "admin" | "operations" | "system"
  requestedById   String?   @db.VarChar(64) @map("requested_by_id")
  idempotencyKey  String?   @db.VarChar(191) @map("idempotency_key") // makes a retried create a no-op
  resolvedAt      DateTime? @map("resolved_at")
  resolvedByType  String?   @db.VarChar(16) @map("resolved_by_type")
  resolvedById    String?   @db.VarChar(64) @map("resolved_by_id")
  resolutionNote  String?   @db.Text @map("resolution_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  documents       RequestDocument[]

  @@unique([caseId, idempotencyKey])
  @@index([caseId, status])
  @@map("document_requests")
}

// PRIVATE CHARTER ONLY (M5). The link between one Private Charter request / Case and the one Bitrix24
// Deal that Operations works it in. It is separate from the Lead integration, which is unchanged:
// service_requests.bitrix_lead_id and cases.bitrix_lead_id (signed INTEGER Lead IDs), their retry
// columns and every existing Lead ID are not touched, never copied here, never converted into a Deal.
// Corporate Cases and every other service never use this table. The database cannot tell the kinds of
// Case apart, so the future service MUST, in the transaction that creates the row, load the Case and
// refuse unless Case.serviceRequestId is set AND that ServiceRequest's serviceKey equals
// PRIVATE_CHARTER_KEY (common/constants/request.constants.js). A Corporate Case (serviceRequestId NULL)
// and a Case of any other service must be refused.
//
// At most one Deal per request: caseId is unique here, and Case.serviceRequestId is unique, so a request
// has at most one Case and therefore at most one link. The ServiceRequest is DERIVED through the Case
// and is deliberately not stored in this table, so there is no second reference that could disagree.
// The row may be created BEFORE Bitrix is called, with bitrixDealId NULL and syncStatus "pending";
// bitrixDealId is filled in when Bitrix answers. A row with a NULL bitrixDealId is not a Deal. Retry
// scheduling and attempt counts belong to the future IntegrationOutbox, not to this table.
//
// M6 RELIABILITY REQUIREMENT (not implemented here): a pre-created link with a NULL bitrixDealId does
// NOT by itself guarantee exactly-once Deal creation. If Bitrix creates the Deal but HumanCare crashes
// (or loses the response) before saving the returned Deal ID, the row still reads "no Deal yet" and a
// retry would create a second Deal. M6 MUST provide durable idempotency and recovery / reconciliation
// for that case (for example, before creating, look the Deal up in Bitrix by the request's reference
// number, and record the attempt durably in the outbox), so retries can never create duplicate Deals.
//
// Bitrix IDs: bitrixDealId, categoryId and stageId are opaque and are stored exactly as Bitrix returned
// them, as text. HumanCare never generates, renumbers, truncates, pads or normalises one, and a Deal ID
// is never interchangeable with a Lead ID. The future service MUST reject (never silently trim or
// transform) a value with leading or trailing whitespace, because the case-sensitive utf8mb4_bin
// collation set in the migration (Prisma's schema cannot express a column collation) ignores trailing
// spaces when comparing. The service should also check the value is a plain decimal number string for a
// Deal ID. Note the current Bitrix client reads the response with res.json(), so an ID above 2^53 would
// already have lost precision before it reached this table; real Deal IDs are far below that.
// lastError must never contain a webhook URL, a token or any other secret.
// The Case foreign key is RESTRICT: a Case with a Deal link cannot be deleted.
//
// KNOWN INTEGRITY RISK, FIXED IN M9 (not in M5): the derived request relies on Case.serviceRequestId,
// whose foreign key currently uses ON DELETE SET NULL. Deleting a ServiceRequest would therefore
// detach its Case from the ServiceRequest while its BitrixDealLink remains, losing the historical link
// between the request and its Deal. No code deletes requests today. M9 MUST change that foreign key to
// ON DELETE RESTRICT ON UPDATE CASCADE, and MUST preserve every existing Corporate Case, where
// serviceRequestId is NULL. M5 does not change this foreign key.
model BitrixDealLink {
  id                 Int       @id @default(autoincrement())
  caseId             Int       @unique @map("case_id")
  case               Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  bitrixDealId       String?   @unique @db.VarChar(32) @map("bitrix_deal_id")
  categoryId         String?   @db.VarChar(16) @map("category_id") // Bitrix CATEGORY_ID (the pipeline), as returned
  stageId            String?   @db.VarChar(64) @map("stage_id") // Bitrix STAGE_ID (e.g. "C38:NEW"), as returned
  syncStatus         String    @default("pending") @db.VarChar(24) @map("sync_status") // "pending" | "synced" | "error"
  lastAttemptAt      DateTime? @map("last_attempt_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  externalModifiedAt DateTime? @map("external_modified_at") // Bitrix's own modified time at the last sync, to ignore stale events
  lastError          String?   @db.Text @map("last_error")
  // Per-Deal lease that serializes updates of the Deal's file field (see BitrixDealDocument).
  fileLockedBy       String?   @db.VarChar(64) @map("file_locked_by")
  fileLockedUntil    DateTime? @map("file_locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  documentShares     BitrixDealDocument[]
  quotations         CaseQuotation[]

  // Phase 2: lets case_quotations reference (id, case_id), so a quotation's Deal link must belong to the quotation's own Case.
  @@unique([id, caseId])
  @@index([syncStatus, lastAttemptAt])
  @@map("bitrix_deal_links")
}

// Private Charter document sharing. One row per Admin-authorized share of one HumanCare document (a request_documents row) to
// one Bitrix24 Deal, attached as an ORIGINAL FILE in the Deal's multiple file field UF_CRM_1794832401. Admin authorization to
// share is separate from document review. The HumanCare original is never changed or deleted by sharing or revoking; a revoked
// share only removes the Bitrix attachment, and a re-share is a new generation. See modules/bitrix/deal-document-*.js.
// Statuses: authorized -> attaching -> attached | ambiguous | failed; revoking -> revoked | revoke_failed.
model BitrixDealDocument {
  id                  Int      @id @default(autoincrement())
  dealLinkId          Int      @map("deal_link_id")
  dealLink            BitrixDealLink @relation(fields: [dealLinkId], references: [id], onDelete: Restrict)
  requestDocumentId   Int      @map("request_document_id")
  requestDocument     RequestDocument @relation(fields: [requestDocumentId], references: [id], onDelete: Restrict)
  caseDocumentId      Int?     @map("case_document_id")
  generation          Int      @default(1)
  sha256              String   @db.Char(64)
  sizeBytes           Int      @map("size_bytes")
  detectedType        String   @db.VarChar(16) @map("detected_type") // "pdf" | "jpeg" | "png" | "webp", from the file's own bytes
  shareToken          String   @unique @db.VarChar(64) @map("share_token")
  status              String   @default("authorized") @db.VarChar(24)
  bitrixFileId        String?  @db.VarChar(32) @map("bitrix_file_id")
  fileIdsBefore       Json?    @map("file_ids_before")
  tryCount            Int      @default(1) @map("try_count")
  attempts            Int      @default(0)
  lastError           String?  @db.VarChar(500) @map("last_error")
  authorizedByAdminId Int      @map("authorized_by_admin_id")
  authorizedAt        DateTime @default(now()) @map("authorized_at")
  attachedAt          DateTime? @map("attached_at")
  revokedByAdminId    Int?     @map("revoked_by_admin_id")
  revokedAt           DateTime? @map("revoked_at")
  revokeReason        String?  @db.VarChar(1000) @map("revoke_reason")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([dealLinkId, requestDocumentId, generation], map: "bitrix_deal_documents_link_doc_gen_key")
  @@unique([dealLinkId, bitrixFileId])
  @@index([status])
  @@index([requestDocumentId])
  @@map("bitrix_deal_documents")
}

// PRIVATE CHARTER ONLY (M6). The durable record of an outbound integration event (for example "create
// the Bitrix Deal for this Case", "move its stage"), written in the SAME transaction as the business change
// that caused it, then delivered by a worker. The existing Bitrix Lead integration (the retry columns on
// service_requests / cases and its sweep) is unchanged and does not use this table; Corporate Cases never do.
//
// Payload: JSON holding only explicitly allowlisted fields, in practice stable ids and the few values the
// target needs. NEVER medical content, reports, document contents, passwords, tokens, webhook URLs, other
// secrets, or patient details that are not required. The allowlist is enforced by the future service.
// idempotencyKey is a stable, caller-built key that names the event itself (for example one Deal-create
// event per Case), unique across the table, so writing the same event twice is refused instead of doubled.
// The key is PERMANENT for its event: it is never reused or overwritten. A deliberate new Deal-creation
// attempt requires an explicit, separately authorised recovery decision and a NEW event with a new key (a new
// event identity); the original event and its history stay as they were.
// It is stored exactly as given and compared case-sensitively (utf8mb4_bin, set in the migration; Prisma's
// schema cannot express a column collation). utf8mb4_bin ignores trailing spaces, so the service MUST reject
// (never silently trim or transform) an idempotencyKey or entityId with leading or trailing whitespace.
//
// status: "pending" (due when nextAttemptAt has passed) | "processing" (claimed; lockedUntil is the lease end)
// | "completed" | "failed" | "ambiguous".
//  - "ambiguous": the external call was started and its outcome is UNKNOWN (timeout, lost response, or a
//    worker that died or lost its lease mid-call). Such an event must NEVER simply be sent again; it goes
//    through reconciliation rules R1-R5 below.
//  - "failed": a DEFINITIVE outcome, for example a clear error response proving that no Deal was created, or
//    retries used up. It is terminal for automatic processing: nothing retries, resolves or re-sends it
//    automatically, and it needs an explicit HUMAN decision before any retry or resolution. Like any other
//    result it may be written only by a worker whose lease is still valid (see Concurrency and fencing).
// A non-completed event that has externalCallStartedAt set is NOT automatically "ambiguous"; see Expiry and
// recovery below.
//
// Concurrency and fencing: a worker claims an event with a compare-and-swap UPDATE (status, attempts and the
// lock columns in the WHERE, row count checked), as the document scan worker does, setting status
// "processing", lockedBy, lockedUntil (the lease end) and attempts = attempts + 1.
// A lease is the worker's authority to write. When lockedUntil passes, that authority ENDS immediately,
// whether or not anyone has re-claimed the event. Every result update (completed, failed, ambiguous, or a
// reschedule) MUST be ONE UPDATE whose WHERE verifies ALL of: the event id; status = "processing"; attempts
// equal to the value this worker claimed; lockedBy equal to this worker; and lockedUntil still in the future.
// The number of rows written is checked. An expired worker therefore writes 0 rows: it can NEVER record a
// success or a failure, even if nobody has re-claimed the event, and a stale worker can never overwrite a
// newer result.
// CLOCK: the lease is set and checked with the SAME database-side UTC clock expression, for example
// lockedUntil = UTC_TIMESTAMP(3) + INTERVAL <lease> SECOND when claiming, and lockedUntil > UTC_TIMESTAMP(3)
// in the result update. Application-generated timestamps (what the Prisma client writes) must NOT be mixed
// with MySQL's session-local NOW(3) for lease fencing: if the server's time zone is not UTC the two differ
// by the zone offset. The same applies to nextAttemptAt: set it explicitly with the same UTC expression and
// do not rely on its column default (CURRENT_TIMESTAMP(3) is session-local). Ordinary Prisma client update
// methods use the application's clock, so the claim and the lease-fenced result update need an appropriate
// database-side SQL operation (for example $executeRaw); a Prisma client update is NOT sufficient unless it
// preserves this same-clock guarantee. This has not been tested here.
// LIMIT: database fencing CANNOT cancel an external Bitrix call that is already in progress. An expired or
// stale worker can still finish its HTTP call, and Bitrix may create the Deal, while the database refuses to
// record that worker's result; two external calls for one event can overlap. The lease must therefore be
// longer than the client's request timeout (15 seconds today, bitrix.service.js) with a generous margin, the
// worker must re-check its claim just before starting a call, and the effect of such a call is found by
// reconciliation, never assumed absent.
//
// Expiry and recovery: the recovery sweep MUST tell these cases apart, and may move an event only with the
// same fenced compare-and-swap, never by the expired worker:
//  (a) "processing", lease EXPIRED, externalCallStartedAt NULL: no external call was started, so the event
//      may safely return to "pending".
//  (b) "processing", lease EXPIRED, externalCallStartedAt SET: the outcome of the call is unknown, so the
//      event MUST become "ambiguous" and goes through reconciliation rules R1-R5.
//  (c) "failed": a definitive outcome was already recorded. The sweep leaves it alone, whether or not
//      externalCallStartedAt is set; it waits for a human decision.
// externalCallStartedAt is set and committed BEFORE the external call is made, only by the current claimant
// (with the same lease check), and is kept as historical evidence that a call was attempted. It is never
// cleared, and it does not by itself make an event "ambiguous": only (b) does. A definitive response that
// proves no Deal was created may be recorded as "failed" by a worker whose lease is still valid. If its lease
// has already expired the write is refused and the event is handled by (b), which is the safe outcome.
//
// Ordering: events of one entity (entityType + entityId) are applied strictly in creation order (id). A later
// event MUST NOT be claimed while any earlier event of the same entity is "pending", "processing" or
// "ambiguous", nor "failed" (which stays blocking until a person decides), so a stage update can never
// overtake the Deal-create it depends on. The database does not enforce this: the claim must be ONE atomic
// step that both checks for an earlier non-final event and takes the claim (for example a transaction with a
// locking read of the entity's rows, since MySQL does not allow an UPDATE to subquery its own table
// directly). This has not been tested here.
//
// Exactly-once is NOT claimed. This table gives at-least-once delivery with durable, ambiguity-aware
// recovery. Reconciliation rules R1-R5 for an "ambiguous" Deal-create (the Bitrix API code of the "Primary
// Deal Reference" custom field is NOT verified or invented here; the create call must write the stable
// Private Charter reference into it):
//  R1. Reconcile first: search Bitrix for a Deal with that reference. If a matching Deal is found, adopt its
//      exact Deal ID (stored as text, untouched) and complete the event; the Deal ID, the "completed" status
//      and the BitrixDealLink update are saved in one database transaction.
//  R2. If the lookup fails, times out, or its result is uncertain in any way, the event stays "ambiguous".
//  R3. One empty search result is NOT proof that no Deal exists (the search may lag behind a creation, or the
//      field may have been edited in Bitrix). Reconciliation must be repeated, over a conservative waiting
//      period (its length is a business decision, not set here), before another create is even considered.
//  R4. If any uncertainty remains after that, the event is left for MANUAL REVIEW. HumanCare MUST NEVER
//      automatically create another Deal while the previous outcome is uncertain.
//  R5. A duplicate Deal found later (two Deals with one reference) is reported and alerted, and MUST NEVER be
//      deleted automatically; a person decides.
// Other limits: whether Bitrix can filter on the reference field, and the fact that Bitrix does not enforce
// its uniqueness, are not verified; a periodic duplicate-reference check is required.
// lastError must never contain a webhook URL, a token or any other secret.
// The Case foreign key is RESTRICT: a Case with outbox history cannot be deleted. caseId is nullable for
// events that belong to no Case. Rows are kept for good; nothing in the schema purges them.
model IntegrationOutbox {
  id                    Int       @id @default(autoincrement())
  eventType             String    @db.VarChar(64) @map("event_type") // e.g. "bitrix.deal.create"
  entityType            String    @db.VarChar(40) @map("entity_type") // e.g. "case"
  entityId              String    @db.VarChar(64) @map("entity_id")
  caseId                Int?      @map("case_id")
  case                  Case?     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  idempotencyKey        String    @unique @db.VarChar(191) @map("idempotency_key")
  payload               Json?
  status                String    @default("pending") @db.VarChar(16) // "pending" | "processing" | "completed" | "failed" | "ambiguous"
  attempts              Int       @default(0)
  nextAttemptAt         DateTime  @default(now()) @map("next_attempt_at")
  lockedBy              String?   @db.VarChar(64) @map("locked_by")
  lockedUntil           DateTime? @map("locked_until")
  externalCallStartedAt DateTime? @map("external_call_started_at")
  lastError             String?   @db.Text @map("last_error")
  correlationId         String?   @db.VarChar(64) @map("correlation_id") // matches audit_logs.correlation_id
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  completedAt           DateTime? @map("completed_at")

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@index([caseId])
  @@map("integration_outbox")
}

// PRIVATE CHARTER ONLY (M6). The durable record of an inbound integration event, such as a Bitrix24 webhook
// delivery, stored BEFORE it is processed so that a duplicate, a late or an out-of-order delivery is handled
// safely and a processed event is never applied twice. Existing Lead handling and Corporate flows are unchanged.
//
// Identity: (source, externalEventId) is unique, so a repeated delivery of the same event is recorded once.
// It is NOT assumed that Bitrix supplies a unique delivery id. Before the handler is built, the
// implementation MUST verify whether one exists, by reading Bitrix's documentation for the exact event type
// in use and inspecting a real sample delivery from a NON-production Bitrix account (recording only the shape
// of the payload, never tokens or secrets), and write the finding down. If a reliable delivery id exists,
// externalEventId is that id. If not, externalEventId is built deterministically from the source, the event
// name, the external entity id and the event's own timestamp (for example as a lowercase hex digest), and
// these limits apply: two genuinely different updates of the same entity that carry the same event name and
// the same timestamp (the timestamp's precision is not verified) produce the SAME key, and the second would
// be suppressed as a "duplicate"; and a repeated delivery whose timestamp differs is NOT recognised as a
// duplicate. Protection against accidental suppression: deduplication is not what keeps the data correct.
// The payload is only a hint; the worker always reads the entity's current state from Bitrix and applies it
// by comparing modified times, so processing the same event twice is harmless, and a suppressed event loses
// nothing as long as the state is read again. A periodic reconciliation sweep that re-reads the current state
// of every open Deal is therefore REQUIRED as a safety net, and the key must use the finest timestamp
// precision Bitrix provides. The table keeps no count of suppressed duplicates; adding one is a possible
// future change, not made here.
// externalEventId and entityId are opaque identifiers, stored exactly as given or built and compared
// case-sensitively (utf8mb4_bin, set in the migration). utf8mb4_bin ignores trailing spaces when comparing,
// so the service MUST reject (never silently trim or normalise) an externalEventId or an entityId with
// leading or trailing whitespace.
//
// Payload: JSON with only allowlisted fields (the event name, the entity id and the event timestamp). The
// future handler MUST authenticate the delivery first and MUST NOT store the delivery's authentication
// block or application token, nor any webhook URL, secret, medical content or unnecessary patient detail.
//
// status: "received" (due when nextAttemptAt has passed) | "processing" (claimed; lockedUntil is the lease
// end) | "processed" | "failed" (final) | "ignored" (a duplicate or stale event that changed nothing).
// A "processed" or "ignored" row is final and is never claimed again, so an event is never applied twice.
// Claiming and fencing work as for IntegrationOutbox, including its CLOCK rule: lockedUntil and nextAttemptAt
// are set and checked with the same database-side UTC expression (for example UTC_TIMESTAMP(3)), never with
// application-generated timestamps mixed with MySQL's session-local NOW(3), which needs database-side SQL
// rather than ordinary Prisma client updates. A result is written only by a worker whose lease is still valid
// (id, status "processing", claimed attempts, lockedBy and lockedUntil in the future, all checked in one
// UPDATE), so an expired or stale worker writes nothing. Because each event is applied by reading Bitrix's
// current state, strict ordering between inbox events of one entity is not needed for correctness, and
// repeating a read is harmless.
//
// Out of order: the payload is a hint, not the truth. To apply an event the future worker reads the entity's
// CURRENT state from Bitrix and applies it only if Bitrix's modified time is newer than the one stored on
// the BitrixDealLink (externalModifiedAt), so a late event can never move a Case backwards. externalOccurredAt
// is the event's own time, kept for ordering and diagnosis. entityId is the external id (for Bitrix, the
// exact Deal ID as text, never transformed or confused with a Lead ID).
// lastError must never contain a webhook URL, a token or any other secret. Rows are kept for good.
model IntegrationInbox {
  id                 Int       @id @default(autoincrement())
  source             String    @db.VarChar(32) // e.g. "bitrix24"
  externalEventId    String    @db.VarChar(191) @map("external_event_id")
  eventType          String    @db.VarChar(64) @map("event_type") // e.g. "ONCRMDEALUPDATE"
  entityType         String?   @db.VarChar(40) @map("entity_type") // e.g. "deal"
  entityId           String?   @db.VarChar(64) @map("entity_id")
  externalOccurredAt DateTime? @map("external_occurred_at")
  payload            Json?
  status             String    @default("received") @db.VarChar(16) // "received" | "processing" | "processed" | "failed" | "ignored"
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at")
  lockedBy           String?   @db.VarChar(64) @map("locked_by")
  lockedUntil        DateTime? @map("locked_until")
  lastError          String?   @db.Text @map("last_error")
  receivedAt         DateTime  @default(now()) @map("received_at")
  processedAt        DateTime? @map("processed_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([source, externalEventId])
  @@index([status, nextAttemptAt])
  @@index([entityType, entityId, externalOccurredAt], map: "inbox_entity_modified_idx")
  @@map("integration_inbox")
}

// PRIVATE CHARTER ONLY (M7). An invoice HumanCare issues for a Private Charter Case. It is NOT the legacy
// billing block on `cases` (billing_amount, billing_currency, billing_status, billing_invoiced_at,
// billing_paid_at, billing_notes). Those columns, their meaning, the /admin/billing endpoints and the
// Corporate billing workflow are UNCHANGED by this migration, and nothing here reads or writes them. Nothing
// is backfilled: no Invoice or Payment is created from a legacy value. billing_invoiced_at / billing_paid_at
// are the time an Admin changed a status (admin.service.js), not an invoice date or a payment transaction,
// and must never be copied into issueDate or transactedAt.
// LEGACY BILLING POLICY (approved, for the future application work, NOT done here): PATCH
// /admin/cases/:id/billing (updateCaseBilling) updates any Case today, Private Charter ones included. The
// future implementation MUST make it reject updates for Private Charter Cases (a Case whose ServiceRequest
// serviceKey equals PRIVATE_CHARTER_KEY), while Corporate Cases and every other Case keep working exactly as
// before. Private Charter billing uses Invoice and Payment records only.
// The database cannot tell the kinds of Case apart, so the future service MUST, in the transaction that
// creates an invoice, load the Case and refuse unless Case.serviceRequestId is set AND that ServiceRequest's
// serviceKey equals PRIVATE_CHARTER_KEY (common/constants/request.constants.js). A Corporate Case
// (serviceRequestId NULL) and a Case of any other service must be refused.
//
// One Case can have many invoices; one invoice can have many payments. Rows are kept for good and are never
// deleted or overwritten: a mistaken invoice is voided, never removed. Every foreign key is RESTRICT. Who did
// what is recorded in audit_logs (entityType "invoice"), written in the same transaction; this table keeps no
// actor columns.
//
// status: "draft" (not yet issued) | "issued" | "void". There is deliberately NO "paid", "partially paid" or
// "overdue" status: issuing an invoice and receiving money are separate events, and the amount paid is
// computed from the payments (completed payments minus completed refunds) at read time, never stored here
// and never inferred from a timestamp. "Overdue" is likewise derived from dueDate. issueDate and dueDate are
// the ACTUAL calendar dates on the invoice, supplied by the person who issues it (SQL DATE, written as
// "YYYY-MM-DD" at 00:00 UTC like service_requests.preferred_date); they are never filled from the time a
// status was changed.
//
// VOID POLICY (approved): a "draft" invoice may be voided with a MANDATORY reason. An "issued" invoice may be
// voided only when it has NO completed payment AND NO unresolved pending payment, and again with a mandatory
// reason (CHECK in the migration: a void invoice has voidedAt and a non-blank voidReason, and a non-void
// invoice has neither). An invoice that has ANY completed payment can NEVER be voided, even if it has since
// been fully refunded: money is returned by separate refund records, never by voiding. Pending payments must
// first be cancelled or otherwise resolved before the invoice can be voided. A payment must never be
// completed against an already voided invoice. If an external payment is confirmed AFTER its record was
// cancelled, the actual transaction evidence must be preserved and flagged for financial reconciliation:
// evidence of money received is never discarded. The database cannot see other rows, so the future service
// MUST enforce the void rule in one transaction that locks the invoice row (SELECT ... FOR UPDATE), checks
// that no completed and no unresolved pending payment exists, and sets the status. Voiding and payment
// completion MUST use the same invoice-row locking discipline: every payment write locks the same invoice
// row first and refuses an invoice that is not "issued", so a void and a payment completion cannot
// interleave. Financial history is never deleted or overwritten.
//
// invoiceNumber is the reference printed on the invoice, supplied by Finance exactly as issued. HumanCare
// does not generate, renumber or invent invoice numbers. It is optional (a draft may have none) and, when
// present, unique across all invoices. It is stored exactly as given and compared case-sensitively
// (utf8mb4_bin, set in the migration; Prisma's schema cannot express a column collation). utf8mb4_bin ignores
// trailing spaces when comparing, so the service MUST reject (never silently trim or transform) an
// invoiceNumber or idempotencyKey with leading or trailing whitespace.
//
// MONEY (approved): amount is DECIMAL(14,3), exact, in MAJOR currency units (for example 1250.500 for an
// amount of 1,250.50, 1250.000 for a zero-decimal currency, 12.345 for a three-decimal one), never a float.
// The largest value is 99,999,999,999.999. Three fractional digits let ISO 4217 currencies with zero, two or
// three decimal places be stored exactly; currencies with four decimals (for example CLF, UYW) do not fit and
// must be refused. The DATABASE does not know a currency's precision and would round a value with more than
// three fractional digits, so the future service MUST validate precision itself, BEFORE the database: use
// maintained ISO 4217 currency metadata to find each currency's number of minor-unit digits (0, 2 or 3); refuse
// an unsupported currency; refuse any amount with more fractional digits than that currency allows; NEVER
// silently round; keep the unused trailing digits zero; and pass amounts to the database as exact decimal
// strings, never as JavaScript numbers (the legacy code converts to a number, which is not acceptable here).
// No approved list of currencies exists and none is defined here. currency is an ISO 4217 code, three
// uppercase letters, case-sensitive (utf8mb4_bin) with a CHECK only on its FORM, not on whether the code
// exists. amount must be greater than zero (CHECK). No tax, rounding or accounting rule is defined; none is
// approved.
//
// CHECK CONSTRAINTS: this migration relies on SQL CHECK constraints, which Prisma cannot see. Whether this
// database product and version enforces them is NOT verified: MySQL ignores CHECK before 8.0.16, the server
// version string "26.7.0" does not establish compatibility, and MySQL documents a restriction on CHECK
// constraints for columns used in foreign-key referential actions whose application to RESTRICT is not
// verified here. Before relying on them, and before applying this migration to any shared environment, they
// MUST be verified independently against the actual database product and version, in a separately authorised
// scratch environment. The future service MUST NOT depend on them: it validates every rule itself.
//
// Ownership: (id, caseId, currency) is unique so that Payment can reference it as a composite foreign key.
// That makes the database itself refuse a payment whose Case or currency differs from its invoice's, and,
// because that foreign key is ON UPDATE RESTRICT, refuse any change of an invoice's Case or currency once it
// has payments. idempotencyKey makes a retried create a no-op (unique per Case; NULL never conflicts, so the
// service should always supply one). Its case-sensitive collation matches the other opaque keys.
model Invoice {
  id             Int       @id @default(autoincrement())
  caseId         Int       @map("case_id")
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  invoiceNumber  String?   @unique @db.VarChar(64) @map("invoice_number")
  amount         Decimal   @db.Decimal(14, 3)
  currency       String    @db.VarChar(3)
  status         String    @default("draft") @db.VarChar(16) // "draft" | "issued" | "void"
  issueDate      DateTime? @db.Date @map("issue_date")
  dueDate        DateTime? @db.Date @map("due_date")
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @db.Text @map("void_reason")
  idempotencyKey String?   @db.VarChar(191) @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  payments       Payment[]

  // Phase 2 (quotation workflow). Added by migration 20261118100000; legacy rows keep source "manual", quotation_id NULL.
  // source "quotation" REQUIRES quotationId (CHECK). One invoice per quotation version, permanently, even if voided
  // (UNIQUE quotation_id). The composite foreign key makes the database refuse an invoice whose Case, currency or amount differs
  // from its quotation; MySQL skips it while quotation_id is NULL, so legacy invoices are not checked. Prisma sees it as one-to-many
  // (the single-column unique is the real one-to-one guard) - use findFirst on CaseQuotation.invoices.
  source         String    @default("manual") @db.VarChar(16) // "manual" | "quotation"
  quotationId    Int?      @unique @map("quotation_id")
  quotation      CaseQuotation? @relation(fields: [quotationId, caseId, currency, amount], references: [id, caseId, currency, amount], onDelete: Restrict, onUpdate: Restrict)
  // Full payment is the default. Partial payment only when Operations authorized it: the Admin and the time are required together (CHECK).
  allowPartialPayment               Boolean   @default(false) @map("allow_partial_payment")
  partialPaymentAuthorizedByAdminId Int?      @map("partial_payment_authorized_by_admin_id")
  partialPaymentAuthorizedBy        AdminUser? @relation("InvoicePartialAuthorizer", fields: [partialPaymentAuthorizedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  partialPaymentAuthorizedAt        DateTime? @map("partial_payment_authorized_at")

  @@unique([id, caseId, currency])
  @@unique([caseId, idempotencyKey])
  @@index([caseId, status])
  @@map("invoices")
}

// PRIVATE CHARTER ONLY (M7). One money movement against an invoice: a payment received, or a refund. A
// payment is a separate record from its invoice (issuing an invoice does not mean it is paid), and a refund is
// a separate row of its own that points at the payment it reverses; the original payment is never edited,
// overwritten or removed to show a refund. Partial payments are simply several rows. Rows are kept for good,
// never deleted: a mistaken one is marked "cancelled" or "failed", and audit_logs (entityType "payment")
// records who did what. Nothing is backfilled from the legacy billing_paid_at, which is only the time an
// Admin changed a status. The same Private Charter isolation and legacy billing policy apply as for Invoice:
// the future service MUST refuse any Case that is not a Private Charter Case, and legacy billing updates for
// Private Charter Cases are to be rejected by the future application work, while Corporate billing is
// unchanged.
//
// Ownership: (invoiceId, caseId, currency) is a composite foreign key to invoices (id, case_id, currency), so
// the database refuses a payment attached to an invoice of another Case, or in another currency. It is
// RESTRICT on delete and on update (an invoice's Case or currency cannot be changed under existing payments).
//
// REFUNDS (approved): kind is "payment" or "refund". A refund MUST reference an ORIGINAL payment, never
// another refund. A foreign key alone does not guarantee that, because it can point at any row, so the
// migration adds refundOfKind: for a refund it is always "payment" (CHECK), and the composite foreign key
// (refundOfPaymentId, invoiceId, refundOfKind) references payments (id, invoice_id, kind), so the database
// refuses a refund whose target is not a "payment"-kind row of the SAME invoice. A payment has neither
// refundOfPaymentId nor refundOfKind (CHECK). The service sets refundOfKind to "payment" when it creates a
// refund. Several refunds against one original payment are allowed; every payment and refund row is kept.
// amount is always positive (CHECK); the direction comes from kind, so no negative amounts are stored.
// The database cannot enforce the following, so the future service MUST, in ONE transaction: lock the invoice
// row and then the original payment row (SELECT ... FOR UPDATE, always in that order, to avoid deadlocks);
// refuse a refund unless the original payment is "completed"; sum the completed refunds already recorded
// against that payment; and refuse the refund if the cumulative completed refunds, including this one, would
// exceed the original payment's amount. Likewise it refuses a completed payment total above the invoice
// amount unless an overpayment rule is approved (none is defined here). A refund never changes the invoice's
// status (an invoice that has had any completed payment cannot be voided, even when fully refunded). It must
// not infer an invoice's state from payment timestamps.
//
// status: "pending" | "completed" | "failed" | "cancelled". Only "completed" rows count as money received
// or returned. A "completed" row MUST have transactedAt (CHECK). transactedAt is the ACTUAL time of the
// transaction reported by the bank or gateway, never the time HumanCare recorded it (createdAt is that).
//
// externalReference is the payment's reference at the bank, gateway or other source, preserved exactly as
// given (case-sensitive utf8mb4_bin) and never generated, normalised or trimmed; the service MUST reject
// leading or trailing whitespace. It is unique per (invoice, kind), so recording the same transfer twice on
// one invoice is refused. It is deliberately NOT unique across invoices, because one real transfer may be
// split across several invoices. NULL (no reference) never conflicts. method is free text (for example
// "bank_transfer"), with no list approved yet. idempotencyKey makes a retried create a no-op, unique per
// invoice (the service should always supply one). Amount, precision, currency and CHECK-verification rules are
// the same as for Invoice: DECIMAL(14,3) in major units, validated for precision by the service before the
// database, never silently rounded, passed as exact decimal strings; the CHECK constraints are unverified on
// this database and must be independently verified in a separately authorised scratch environment.
model Payment {
  id                Int       @id @default(autoincrement())
  invoiceId         Int       @map("invoice_id")
  caseId            Int       @map("case_id")
  currency          String    @db.VarChar(3)
  invoice           Invoice   @relation(fields: [invoiceId, caseId, currency], references: [id, caseId, currency], onDelete: Restrict, onUpdate: Restrict)
  kind              String    @default("payment") @db.VarChar(16) // "payment" | "refund"
  refundOfPaymentId Int?      @map("refund_of_payment_id")
  refundOfKind      String?   @db.VarChar(16) @map("refund_of_kind") // "payment" for a refund, NULL for a payment
  refundOf          Payment?  @relation("PaymentRefunds", fields: [refundOfPaymentId, invoiceId, refundOfKind], references: [id, invoiceId, kind], onDelete: Restrict, onUpdate: Restrict)
  refunds           Payment[] @relation("PaymentRefunds")
  amount            Decimal   @db.Decimal(14, 3)
  status            String    @default("pending") @db.VarChar(16) // "pending" | "completed" | "failed" | "cancelled"
  method            String?   @db.VarChar(32)
  externalReference String?   @db.VarChar(191) @map("external_reference")
  transactedAt      DateTime? @map("transacted_at")
  idempotencyKey    String?   @db.VarChar(191) @map("idempotency_key")
  // Razorpay order (migration 20261119100000). NULL for every refund and for every manual / legacy payment; MySQL allows many NULLs
  // in the unique index. One Razorpay order = one payment row. Case-sensitive (utf8mb4_bin in the migration). CHECKs in the migration:
  // the form "order_<alphanumeric>", NULL on a refund, and a completed Razorpay payment must carry its gateway payment id in
  // externalReference. Set once when the order is created and never changed by the service.
  razorpayOrderId   String?   @unique @db.VarChar(64) @map("razorpay_order_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([id, invoiceId, kind])
  @@unique([invoiceId, kind, externalReference])
  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId, caseId, currency])
  @@index([refundOfPaymentId, invoiceId, refundOfKind])
  @@index([invoiceId, status])
  @@index([caseId])
  @@map("payments")
}

// PRIVATE CHARTER ONLY (Phase 2). One row per quotation VERSION of a Case: the PDF Operations upload to the Bitrix24 Deal
// (UF_CRM_1794985313) plus the Final Quotation Amount and Currency (UF_CRM_6A3399F56ECFF, UF_CRM_6A23F4E86AA45). The future service
// MUST, in the transaction that creates a row, lock the Case (SELECT ... FOR UPDATE) and refuse unless the Case is a Private Charter
// Case (serviceRequestId set and serviceKey = PRIVATE_CHARTER_KEY) with a synced Deal that is not Won or Lost. The database cannot tell.
// The file is stored OUTSIDE MySQL (storageKey is an opaque unique key, storageProvider says where); the Bitrix signed download URL is
// never stored. Every file has its own storageKey and an existing file is never overwritten.
//
// Statuses: draft -> confirmed -> published -> accepted | rejected | withdrawn | superseded. (Expired is COMPUTED from validUntil,
// never stored.) draft/confirmed may also go to withdrawn; confirmed returns to draft when its content changes. rejected, withdrawn and
// superseded are final. accepted never changes status; when a newer version is published only supersededAt / supersededById (set once)
// and liveSlot change. A superseded published quotation gets status "superseded" (CHECK-enforced).
//
// Slots (no triggers, no generated column): workingSlot is 1 exactly while status is draft|confirmed and liveSlot is 1 exactly while
// status is published|accepted AND supersededAt is NULL; otherwise both are NULL (CHECKs). UNIQUE (caseId, workingSlot) and
// (caseId, liveSlot) therefore give at most one unpublished working version and at most one live version per Case, because MySQL
// unique indexes ignore NULLs.
//
// Versions: UNIQUE (caseId, versionNumber). bitrixFileId is deliberately NOT unique (one file can legitimately carry several versions,
// for example after an amount change). Duplicate-fetch detection compares contentFingerprint (SHA-256 of pdf sha256 + canonical amount
// + currency) with the head version (highest versionNumber) under the Case row lock. Bitrix values are kept raw
// (bitrixAmountRaw / bitrixCurrencyRaw); amount/currency are the parsed form, NULL until valid, and are NEVER rounded: the database
// would round a 4th decimal silently (verified), so the service MUST validate precision first (DECIMAL(14,3), ISO 4217 digits 0/2/3).
//
// Immutability (enforced by the single writer module, row locking, revision compare-and-set, the CHECKs below, audit_logs and file
// hash verification, NOT by triggers): after publication the content, money, file, validUntil, confirmation and publication fields are
// frozen; after acceptance the decision is frozen too. Acceptance evidence is the patient's user id, this exact version, the decision
// time and (for a rejection) the mandatory reason; no IP address or device data is collected. The CHECKs in the migration
// (case_quotations_*_chk) are not visible to Prisma.
model CaseQuotation {
  id                 Int       @id @default(autoincrement())
  caseId             Int       @map("case_id")
  case               Case      @relation("CaseToQuotation", fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dealLinkId         Int       @map("deal_link_id")
  dealLink           BitrixDealLink @relation(fields: [dealLinkId, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict)
  bitrixDealId       String    @db.VarChar(32) @map("bitrix_deal_id") // snapshot, exactly as Bitrix returned it (utf8mb4_bin in the migration)
  versionNumber      Int       @map("version_number")

  // Bitrix source values, preserved raw for audit.
  bitrixFileId       String    @db.VarChar(32) @map("bitrix_file_id") // not unique, see above (utf8mb4_bin)
  bitrixAmountRaw    String?   @db.VarChar(64) @map("bitrix_amount_raw")
  bitrixCurrencyRaw  String?   @db.VarChar(32) @map("bitrix_currency_raw")
  bitrixDealStageId  String?   @db.VarChar(64) @map("bitrix_deal_stage_id")
  contentFingerprint String    @db.Char(64) @map("content_fingerprint")

  // The PDF, outside MySQL.
  storageProvider    String    @default("local") @db.VarChar(16) @map("storage_provider") // "local" | "s3"
  storageKey         String    @unique @db.VarChar(191) @map("storage_key") // opaque, unique per file (utf8mb4_bin)
  sizeBytes          Int       @map("size_bytes")
  sha256             String    @db.Char(64)
  scanStatus         String    @default("pending") @db.VarChar(16) @map("scan_status") // "pending" | "clean" | "infected" | "error"
  scanEngine         String?   @db.VarChar(40) @map("scan_engine")
  scanDetail         String?   @db.VarChar(255) @map("scan_detail")
  scannedAt          DateTime? @map("scanned_at")
  scanAttempts       Int       @default(0) @map("scan_attempts")
  scanNextAttemptAt  DateTime? @map("scan_next_attempt_at")

  // Money: DECIMAL(14,3) in major units, ISO 4217 form (three uppercase letters, utf8mb4_bin). Both NULL until valid.
  amount             Decimal?  @db.Decimal(14, 3)
  currency           String?   @db.VarChar(3)
  validationError    String?   @db.VarChar(64) @map("validation_error") // short code, never raw values
  validUntil         DateTime? @map("valid_until")

  // Lifecycle.
  status             String    @default("draft") @db.VarChar(16)
  workingSlot        Int?      @map("working_slot")
  liveSlot           Int?      @map("live_slot")
  revision           Int       @default(0) // compare-and-set token, +1 on every write
  lastSeenAt         DateTime? @map("last_seen_at") // last time Bitrix returned identical content (throttled)

  confirmedByAdminId Int?      @map("confirmed_by_admin_id")
  confirmedBy        AdminUser? @relation("QuotationConfirmer", fields: [confirmedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedAt        DateTime? @map("confirmed_at")
  publishedByAdminId Int?      @map("published_by_admin_id")
  publishedBy        AdminUser? @relation("QuotationPublisher", fields: [publishedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedAt        DateTime? @map("published_at")
  withdrawnByAdminId Int?      @map("withdrawn_by_admin_id")
  withdrawnBy        AdminUser? @relation("QuotationWithdrawer", fields: [withdrawnByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnAt        DateTime? @map("withdrawn_at")
  withdrawReason     String?   @db.VarChar(1000) @map("withdraw_reason")

  // Patient decision (acceptance evidence).
  decidedByUserId    Int?      @map("decided_by_user_id")
  decidedBy          User?     @relation("QuotationDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedAt          DateTime? @map("decided_at")
  rejectionReason    String?   @db.Text @map("rejection_reason")

  // Supersession: the only thing that may change on an accepted row (set once). The successor must be in the same Case.
  supersededAt       DateTime? @map("superseded_at")
  supersededById     Int?      @map("superseded_by_id")
  supersededBy       CaseQuotation?  @relation("QuotationSuccession", fields: [supersededById, caseId], references: [id, caseId], onDelete: Restrict, onUpdate: Restrict)
  supersedes         CaseQuotation[] @relation("QuotationSuccession")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  invoices           Invoice[]

  @@unique([caseId, versionNumber])
  @@unique([caseId, workingSlot])
  @@unique([caseId, liveSlot])
  @@unique([id, caseId])
  @@unique([id, caseId, currency, amount], map: "case_quotations_id_case_currency_amount_key")
  @@index([caseId, status])
  @@index([dealLinkId, caseId])
  @@index([status, validUntil])
  @@index([scanStatus, scanNextAttemptAt])
  @@map("case_quotations")
}

model Document {
  id            Int      @id @default(autoincrement())
  caseId        Int      @map("case_id")
  case          Case     @relation(fields: [caseId], references: [id])
  // Nullable — the original "attach medical report while submitting a request" upload
  // never set this, so older rows won't have it. New uploads (see
  // cases.controller.js#uploadCaseDocument) always set one.
  type          String?
  name          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@index([caseId])
  @@map("documents")
}

// Company-level compliance documents (registration certificate, GST, PAN, etc.) — a
// corporate uploading these to its own profile, not tied to any one case. Deliberately
// has no status/verification field: that review workflow isn't built, so this just
// stores and lists what was uploaded rather than pretending to track Verified/Pending/
// Expired/Rejected state nobody is actually setting.
model CorporateDocument {
  id            Int      @id @default(autoincrement())
  corporateId   Int      @map("corporate_id")
  corporate     Corporate @relation(fields: [corporateId], references: [id])
  type          String
  name          String
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  @@index([corporateId])
  @@map("corporate_documents")
}

model Notification {
  id            Int       @id @default(autoincrement())
  recipientType String    @map("recipient_type") // "patient" | "corporate_user"
  recipientId   Int       @map("recipient_id")
  kind          String    @default("system") // "stage_update" | "quotation_ready" | "document" | "system"
  title         String
  body          String?   @db.Text
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  // M8: Prisma back-relation only; no column is added to `notifications`. A Notification remains the in-app
  // message and keeps its meaning, including being deleted by its owner.
  deliveries    NotificationDelivery[]

  @@index([recipientType, recipientId, readAt])
  @@map("notifications")
}

// M8. The delivery record of ONE channel ("push" or "sms") for ONE in-app Notification. The Notification stays
// the in-app message and is unchanged in meaning and use: the in-app list, read/unread, mark-all-read and
// delete (Corporate portal and patient app) keep working exactly as before. This table only tracks whether
// and how the same message was also sent out of the app. Existing notifications get NO delivery row: nothing
// is backfilled and no history is invented. Today push is sent best-effort and untracked (cases.service.js
// notifyPatient -> expo-push.service.js) and the backend sends NO SMS at all (OTP SMS is sent by Firebase from
// the app); this migration changes none of that. "sms" is a channel the schema can describe; no SMS provider
// is chosen or implied, and `provider` is free text ("expo" for the current push path).
//
// One row per (notification, channel): a notification is tracked at most once per channel. Retries are
// attempts of the same delivery (NotificationDeliveryAttempt), never a second delivery row.
//
// DELETE BEHAVIOUR: a user can delete a Notification (notifications.service.js deleteNotification), so the
// foreign key is ON DELETE SET NULL, not RESTRICT (RESTRICT would break that existing feature). The delivery
// row and its attempts are kept as history; recipientType/recipientId are copied here when the row is
// created so history still says whose message it was. A delivery whose Notification is gone has no message to
// send: the future service MUST cancel it if it is still pending. A delivery stores NO message text and NO
// destination (no push token, no phone number): the future service reads the title/body from the Notification
// and the destination from the recipient's current record at send time.
//
// status — what is actually known, and no more:
//   "pending"   not yet sent; due when nextAttemptAt has passed.
//   "sending"   claimed by a worker (lockedBy/lockedUntil lease, same claiming and fencing rules and the same
//               database-side UTC CLOCK rule as IntegrationOutbox); an attempt row is written first.
//   "accepted"  the provider ACCEPTED the request and returned (or did not need) a reference. This is NOT
//               proof that the message reached the device or the person. acceptedAt is set.
//   "delivered" the provider CONFIRMED delivery by its own definition (deliveredAt set). Only set when a
//               provider really reports it; a channel/provider that cannot confirm never reaches this status.
//               What the confirmation means differs by provider (for example a push receipt may confirm only
//               hand-off to the platform push service) and MUST be checked against the provider's documents
//               before the service claims more than that.
//   "failed"    final failure (closedAt set). "cancelled" will not be sent (closedAt set).
//   "uncertain" a request may have reached the provider but the outcome is unknown (timeout, crash after the
//               call began). It is NOT retried automatically, because a retry could send a duplicate; a person
//               or a reconciliation rule decides. Most providers give no idempotency key, so duplicate sends
//               cannot be fully ruled out after an uncertain outcome.
// attemptCount is the number of attempt rows written; the future service increments it and inserts the
// attempt in the SAME transaction (the database cannot enforce that equality). There is deliberately no
// maximum-attempts or backoff value here: those are service/business decisions not yet made.
// lastErrorCode/lastError hold a SHORT, sanitised, application-defined description of the last failure. They
// must never contain a push token, phone number, message text, provider credential, webhook or URL with a
// secret, or patient information; store the provider's error CODE, not its raw response.
// providerMessageId is the provider's reference for the accepted message (case-sensitive, utf8mb4_bin in the
// migration), kept so a later receipt can be matched.
// CHECKs in the migration (channel and status values, attemptCount >= 0, accepted/delivered need their
// timestamp) were all tested against MySQL Community Server - GPL 26.7.0 on humancare_test, using temporary,
// prefixed copies of the tables: the compatibility test passed and did not modify existing application tables
// or data. The M8 migration itself has NOT yet been applied. The service still validates every rule. The
// CHECKs cover no column used by the SET NULL foreign key, because MySQL forbids that.
model NotificationDelivery {
  id                Int                           @id @default(autoincrement())
  notificationId    Int?                          @map("notification_id")
  notification      Notification?                 @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipientType     String                        @db.VarChar(32) @map("recipient_type") // copied from the Notification: "patient" | "corporate_user"
  recipientId       Int                           @map("recipient_id")
  channel           String                        @db.VarChar(16) // "push" | "sms"
  provider          String?                       @db.VarChar(32)
  status            String                        @default("pending") @db.VarChar(16) // "pending" | "sending" | "accepted" | "delivered" | "failed" | "cancelled" | "uncertain"
  attemptCount      Int                           @default(0) @map("attempt_count")
  nextAttemptAt     DateTime                      @default(now()) @map("next_attempt_at")
  lockedBy          String?                       @db.VarChar(64) @map("locked_by")
  lockedUntil       DateTime?                     @map("locked_until")
  providerMessageId String?                       @db.VarChar(191) @map("provider_message_id")
  acceptedAt        DateTime?                     @map("accepted_at")
  deliveredAt       DateTime?                     @map("delivered_at")
  closedAt          DateTime?                     @map("closed_at")
  lastErrorCode     String?                       @db.VarChar(64) @map("last_error_code")
  lastError         String?                       @db.VarChar(512) @map("last_error")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  attempts          NotificationDeliveryAttempt[]

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([recipientType, recipientId])
  @@map("notification_deliveries")
}

// M8. One try at sending a NotificationDelivery. Rows are the history of failures and retries and are kept
// for good: never deleted, and never overwritten once finished (only a "started" row is finalised). The
// future worker writes the row with status "started" BEFORE calling the provider, so a crash mid-call leaves
// evidence; it then finalises it as "accepted", "failed" or "uncertain" (never left "started" once the
// outcome is known; a stale "started" row is found through the status/startedAt index and treated as
// "uncertain"). attemptNumber starts at 1 and is unique per delivery, which also stops two workers from
// recording the same attempt. errorCode/errorMessage follow the same no-secrets, no-patient-data,
// no-raw-provider-response rule as NotificationDelivery.lastError. providerMessageId is the reference the
// provider returned for THIS attempt, if any. The foreign key to the delivery is RESTRICT on delete: a
// delivery with attempts cannot be deleted.
model NotificationDeliveryAttempt {
  id                Int                  @id @default(autoincrement())
  deliveryId        Int                  @map("delivery_id")
  delivery          NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  attemptNumber     Int                  @map("attempt_number")
  status            String               @default("started") @db.VarChar(16) // "started" | "accepted" | "failed" | "uncertain"
  provider          String?              @db.VarChar(32)
  providerMessageId String?              @db.VarChar(191) @map("provider_message_id")
  errorCode         String?              @db.VarChar(64) @map("error_code")
  errorMessage      String?              @db.VarChar(512) @map("error_message")
  startedAt         DateTime             @default(now()) @map("started_at")
  finishedAt        DateTime?            @map("finished_at")

  @@unique([deliveryId, attemptNumber])
  @@index([status, startedAt])
  @@map("notification_delivery_attempts")
}

// The local GeoNames populated-place table that Private Charter origin and destination cities are
// searched and verified against (no GeoNames account or network call at runtime). Filled by
// scripts/import-geonames.js from the free GeoNames dump; see backend/GEONAMES-DATASET.md.
//
// Data: GeoNames (https://www.geonames.org), licensed CC BY 4.0. Only populated places (feature
// class P) are loaded, without the historical, abandoned and destroyed ones, and the columns are
// reduced to the ones below.
//
// `verifiedAt` is when an import last saw the record. A record older than GEONAMES_MAX_AGE_DAYS
// (180 by default) is not accepted any more, so a dataset that is not refreshed fails closed.
model GeonamesCity {
  geonameId   Int      @id @map("geoname_id")
  name        String   @db.VarChar(200)
  asciiName   String   @db.VarChar(200) @map("ascii_name")
  admin1Name  String?  @db.VarChar(200) @map("admin1_name")
  countryCode String   @db.VarChar(2) @map("country_code")
  featureCode String   @db.VarChar(10) @map("feature_code")
  population  Int      @default(0)
  timezone    String   @db.VarChar(64)
  verifiedAt  DateTime @map("verified_at")
  names       GeonamesCityName[]

  // Covering indexes for the city search: a prefix range on the name carries each place's
  // population too, so the biggest matches are found without reading the table rows (the search
  // would otherwise take seconds on a short prefix over 5 million places).
  @@index([name, population])
  @@index([asciiName, population])
  @@index([verifiedAt])
  @@map("geonames_cities")
}

// Other names of a city in geonames_cities (translations, local spellings in other scripts, old
// names, ASCII spellings: "München" for Munich), so the picker finds a city by any of them. The
// city's own name and its id stay the canonical ones in every result: this table is only used to
// FIND the city. Comes from the same dump line as the city, so it is refreshed with it, and goes
// when the city goes. `population` repeats the city's, so a short query can be limited to bigger
// places inside the index.
model GeonamesCityName {
  geonameId  Int          @map("geoname_id")
  name       String       @db.VarChar(200)
  population Int          @default(0)
  city       GeonamesCity @relation(fields: [geonameId], references: [geonameId], onDelete: Cascade)

  @@id([geonameId, name])
  @@index([name, population])
  @@map("geonames_city_names")
}
