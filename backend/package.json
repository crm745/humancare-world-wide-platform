{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:worker:push": "node src/push-delivery-worker.js",
    "start:worker:synthetic-e2e": "node src/synthetic-e2e-worker.js",
    "e2e:synthetic": "node scripts/synthetic-e2e-orchestrator/run.js",
    "e2e:fixture-pdf": "node scripts/e2e-fixture-pdf.js",
    "dispatch:deal-event": "node scripts/dispatch-deal-event.js",
    "e2e:quotation-case-1206": "node scripts/e2e-quotation-case-1206.js",
    "test:synthetic-orchestrator": "node --test tests/isolation/synthetic-*.node-test.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:isolation": "node --test tests/isolation/upload-dir-and-lock.node-test.js",
    "migrate:dev": "prisma migrate deploy",
    "migrate:test": "node scripts/test-db.js migrate",
    "test:db": "node scripts/test-db.js",
    "e2e:mail": "node scripts/e2e-mail-sink.js",
    "migrate:all": "npm run migrate:dev && npm run migrate:test",
    "test:safe": "cross-env NODE_ENV=test jest --config jest.safe.config.js --runInBand",
    "integration:db": "cross-env HUMANCARE_INTEGRATION_RUN=true node scripts/integration-db.js",
    "test:scoped:request-review": "cross-env NODE_ENV=test HUMANCARE_SCOPED_RUN=true jest --config jest.scoped.config.js --runInBand",
    "test:scoped:cleanup": "node scripts/scoped-test-cleanup.js",
    "test:integration": "cross-env NODE_ENV=test HUMANCARE_INTEGRATION_RUN=true jest --config jest.integration.config.js --runInBand",
    "devdb:generate": "prisma generate --schema .devdb/schema.prisma",
    "test:devdb": "cross-env NODE_ENV=development HUMANCARE_DEVDB_RUN=true jest --config jest.devdb.config.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.1173.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^14.0.3",
    "apple-signin-auth": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.10",
    "multer": "^2.4.0",
    "nodemailer": "10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mailparser": "^3.14.1",
    "playwright": "^1.49.1",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1"
  }
}
