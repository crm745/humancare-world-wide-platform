# Settings for the dedicated TEST environment. Copy to backend/.env.test (Git ignores that file) and
# fill in the values privately. NEVER put the development credentials or secrets here.
#
# Everything that runs in tests loads ONLY this file. A safety guard (src/common/safety/test-database-guard.js)
# refuses to run unless these rules hold:
#   - DATABASE_URL: mysql://, on this machine, database exactly "humancare_test", user starting with
#     "humancare_test" (the restricted user, e.g. humancare_test_app), and only the options shown.
#   - EMAIL_PROVIDER=smtp to 127.0.0.1 (the local capture sink, `npm run e2e:mail`) or "console".
#   - UPLOAD_DIR=.e2e-uploads (backend/.e2e-uploads), never the shared uploads folder.

# The restricted MySQL user created for tests. Password: set it yourself, do not reuse the dev one.
DATABASE_URL="mysql://humancare_test_app:CHANGE_ME@localhost:3306/humancare_test?connection_limit=20"

# New random values, different from the development ones, so test tokens are never valid elsewhere.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# The E2E backend listens here (not 4000, so the development backend is never hit by mistake).
PORT=4100

# Test uploads: the only accepted value.
UPLOAD_DIR=".e2e-uploads"

# Mail goes only to the local capture sink. Recipients must be @e2e.humancare.invalid.
EMAIL_PROVIDER="smtp"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER="test"
SMTP_PASS="test"
EMAIL_FROM="HumanCare E2E <noreply@e2e.humancare.invalid>"

# Admin Lock. The origin and RP ID must match the Admin Portal run for the browser tests.
ADMIN_PORTAL_URL="http://localhost:3000"
ADMIN_WEBAUTHN_ORIGIN="http://localhost:3000"
ADMIN_WEBAUTHN_RP_ID="localhost"
ADMIN_WEBAUTHN_RP_NAME="HumanCare Admin (test)"
ADMIN_PASSKEY_ENFORCEMENT=true

# Nothing real may be contacted.
BITRIX24_WEBHOOK_URL=""
BITRIX_SYNC_ENABLED="false"
FIREBASE_SERVICE_ACCOUNT_PATH=""
PHONE_OTP_PROVIDER="console"
