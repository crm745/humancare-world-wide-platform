# Copy this file to .env and fill in real values for your local machine.
# .env is never committed to git — each developer keeps their own.

DATABASE_URL="mysql://username:password@localhost:3306/humancare_dev"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
PORT=4000

# Optional — used by scripts/seed-admin.js and scripts/seed-corporate.js. Leave unset and
# those scripts generate (and print) a random password instead of using a fixed one.
INITIAL_ADMIN_PASSWORD=""
INITIAL_CORPORATE_PASSWORD=""

# Bitrix24 inbound webhook (Settings > Developer resources > Other > Inbound webhook, CRM scope).
# Ask whoever administers HumanCare's Bitrix24 portal for this.
BITRIX24_WEBHOOK_URL="https://your-portal.bitrix24.com/rest/1/your-webhook-token/"
# Sends to Bitrix24 only when exactly "true". Anything else (or missing) = nothing is sent.
BITRIX_SYNC_ENABLED=false

# Google Sign-In — from Google Cloud Console > APIs & Services > Credentials.
# You need a separate OAuth client ID per platform; only set the ones you actually use.
GOOGLE_CLIENT_ID_IOS=""
GOOGLE_CLIENT_ID_ANDROID=""
GOOGLE_CLIENT_ID_WEB=""

# Sign in with Apple — from Apple Developer > Identifiers. Use the app's Bundle ID
# (or the Services ID if you're doing the web-based flow).
APPLE_CLIENT_ID=""

# Email (all of it: OTP codes, corporate registration links) - see src/lib/mailer.js.
# Google Workspace: SMTP_USER = the mailbox, SMTP_PASS = its 16-letter App Password
# (Google Account > Security > App passwords; needs 2-Step Verification). EMAIL_FROM is
# the sender people see. Blank EMAIL_PROVIDER = smtp if SMTP_USER/SMTP_PASS are set,
# else console (prints emails to the server log; refused when NODE_ENV=production).
EMAIL_PROVIDER=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="HumanCare World Wide <noreply@humancareworldwide.com>"

# Mobile codes via Firebase phone sign-in: set to "firebase" and the app asks Firebase to
# send and check SMS codes; the backend only checks Firebase's signed proof (see
# src/integrations/firebase/firebase.js). Blank = the backend's own codes, which it only prints to the
# server log (development; refused when NODE_ENV=production). Email codes are unaffected.
PHONE_OTP_PROVIDER=""
# Full path to the Firebase service-account key (Firebase console > Project settings >
# Service accounts > Generate new private key). Keep it outside the repo; never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Days to keep security log entries (logins, lockouts, password/contact changes).
# Older ones are deleted daily. Keep at least 180 (CERT-In); confirm with legal.
SECURITY_LOG_RETENTION_DAYS=365

# Base URL of the corporate-portal web app, used to build the link in a corporate
# registration's "verify your email" message (see corporate-registration.service.js).
CORPORATE_PORTAL_URL="http://localhost:5173"

# Admin Lock (passkey-protected Admin access) - see src/modules/admin/auth/admin-lock.config.js.
# ADMIN_PASSKEY_ENFORCEMENT only controls whether Admin login requires a passkey (off unless
# exactly "true"); Admins can still register passkeys while it is off. The other settings have
# no built-in defaults and nothing falls back to localhost; each is validated when its
# feature is used: ADMIN_PORTAL_URL when an invitation/recovery link is built, the
# ADMIN_WEBAUTHN_* trio when a passkey ceremony starts (and at startup if enforcement is on).
# In production the URLs must be https and non-localhost.
ADMIN_PASSKEY_ENFORCEMENT=false
# Base URL of the Admin portal, used to build invitation / recovery links (required for invitations).
ADMIN_PORTAL_URL=""
# WebAuthn Relying Party ID: the bare domain of the Admin portal (no scheme/port/path); must
# equal or be a parent of the ADMIN_WEBAUTHN_ORIGIN host. Changing it later orphans every
# registered passkey. Local development example: localhost
ADMIN_WEBAUTHN_RP_ID=""
# Exact browser origin of the Admin portal (scheme + host + optional port, no trailing slash).
# Local development example (the admin portal's dev server): http://localhost:3000
ADMIN_WEBAUTHN_ORIGIN=""
# Name shown to the user in the browser's passkey prompt.
ADMIN_WEBAUTHN_RP_NAME="HumanCare World Wide Admin"
