# Example backend settings. Copy the lines you need into backend/.env. This file holds NO secrets and is never read by the application.
# (Only the settings documented so far are listed here; see the other docs in this folder for the rest.)

# ---- Bitrix24: shared rate limit --------------------------------------------------------------------------------------------
# ONE limiter paces every Bitrix24 call of every worker (Deal, documents, quotations, inbox, reconciliation, legacy Leads).
# Leave a line out (or empty) to use its default. A value that is not a plain positive number within its bounds is NOT ignored:
# the API and the worker refuse to start and name the variable.
#
# Sustained calls per second. Positive number, decimals allowed (0.5 = one call every two seconds). Default 2. At most 50.
BITRIX_RATE_LIMIT_PER_SECOND=2
# Burst capacity: how many calls may go out back to back before pacing applies. Positive whole number. Default 10. At most 1000.
BITRIX_RATE_LIMIT_BURST=10
# Calls in flight at the same time. Positive whole number. Default 1. At most 20.
BITRIX_MAX_CONCURRENT_REQUESTS=1

# ---- Private Charter automatic approval (OFF by default; every line below is OPTIONAL and commented out on purpose) -------------
# Genuine requests need ALL of: PRIVATE_CHARTER_AUTO_APPROVE=true, PRIVATE_CHARTER_AUTO_APPROVE_FROM=<ISO time: the one explicit cutoff>,
# PRIVATE_CHARTER_REVIEW_WORKFLOW=true, BITRIX_DEAL_PROFILE=actual and PRIVATE_CHARTER_AUTO_APPROVE_ACCEPT_UNVERIFIED_CONTENT=true
# (a person knowingly accepting approval on file type and structure only; keep it OFF everywhere except a local test).
#
# Designated E2E test identity (local humancare_dev only; refused under NODE_ENV=production): runs the real workflow with TEST data without
# the genuine acceptance above. The owning account's number must be listed AND the patient name must start with E2E-TEST.
# PRIVATE_CHARTER_AUTO_APPROVE_E2E_MODE=true
# PRIVATE_CHARTER_AUTO_APPROVE_E2E_MOBILES=<1 to 5 Firebase TEST numbers in E.164, comma separated>

# ---- Patient push notifications (Expo) ------------------------------------------------------------------------------------------
# Push delivery is OFF BY DEFAULT. The dedicated push worker (npm run start:worker:push; run exactly one) sends patients' push notifications only when ALL of these hold:
#   * PUSH_DELIVERY_ENABLED is exactly the word true (anything else, a missing line or an empty value keeps it off: "TRUE", "1", "yes" do NOT turn it on);
#   * EXPO_PUSH_ACCESS_TOKEN holds a valid Expo access token (otherwise the worker stays off, fails closed and says so in its log);
#   * this is not a test, scoped, integration or synthetic run (those never send, whatever the switch says).
# The push worker prints one startup line and a summary every 10 minutes (flags and counts only) saying whether it sends and why not.
# Do NOT turn this on in a shared or production environment before the activation decision has been taken.
PUSH_DELIVERY_ENABLED=false
# The Expo access token ("enhanced push security"), from the Expo dashboard. BACKEND ONLY: it is sent in the Authorization header of requests to Expo
# and nowhere else. Never put it in the mobile app, never commit it, never share it. Leave it EMPTY here; set the real value in backend/.env only.
EXPO_PUSH_ACCESS_TOKEN=
