node_modules
# Keep environment variables out of version control
.env
.env.test

# Present only while a manual integration session uses humancare_test: tests/global-setup.js refuses to run
/.integration-session.lock

# Backups, snapshots and reports of scoped test runs (a backup holds a copy of the test database)
/.scoped-runs/

/src/generated/prisma

# Test-only folders (isolated uploads and captured mail; mail holds one-time tokens)
.e2e-uploads/
.e2e-mail/

# Synthetic E2E orchestrator: per-run manifests/reports/screenshots and operator-local config (never commit)
/.synthetic-e2e-runs/
/scripts/synthetic-e2e-orchestrator/phone-pool.local.json
/scripts/synthetic-e2e-orchestrator/network-risk-acknowledgment.local.json
