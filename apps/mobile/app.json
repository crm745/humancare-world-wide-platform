{
  "expo": {
    "name": "HumanCare World Wide",
    "slug": "humancare-worldwide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humancareworldwide.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.humancareworldwide.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HumanCare uses your camera only when you tap Camera on the New Request form, to photograph a medical report for your coordinator.",
          "photosPermission": "HumanCare accesses your photos only when you choose a picture of a medical report to attach to a request.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#303A8F"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-localization"
    ],
    "scheme": "humancare",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2d77653-3b13-40b5-9bfa-50b04cd52904"
      }
    }
  }
}
